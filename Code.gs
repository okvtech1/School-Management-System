/* ============================== UPGRADE / SUBSCRIPTION REQUESTS ============================== */
/* Bank-transfer-based upgrade, no payment processor. Flow:
   1. Admin submits the form on upgrade.html (org/contact info, chosen plan, payment screenshot).
   2. This creates an upgradeRequest Data record and emails OWNER_EMAIL with everything, including
      the screenshot as an attachment.
   3. Victor reviews the payment manually, then edits ONE cell — the upgradeReviewStatus column on
      that org's Super Administrator row in the Users sheet — to "confirmed" or "rejected".
   4. The onEdit(e) simple trigger below fires automatically on that edit, updates the org's
      subscription (if confirmed) and emails the customer their status — no code deploy, no extra
      login, exactly the "manage everything via the Sheet" model this whole project has used
      since day one. */

const BILLING_CYCLE_DAYS = { monthly: 30, biannual: 182, yearly: 365 };

function handleSubmitUpgradeRequest(body, admin) {
  const { orgName, fullName, email, phone, requestedPlan, requestedBillingCycle, requestedLabel, paymentScreenshotDataUrl } = body;
  if (!orgName || !fullName || !email || !phone || !requestedPlan || !requestedBillingCycle) {
    return { ok: false, error: 'Please fill in every field.' };
  }
  if (!PLAN_NAMES[requestedPlan]) return { ok: false, error: 'Unknown plan' };

  const dataSheet = getSheet(DATA_SHEET, admin.orgId);
  const nowIso = new Date().toISOString();
  const recordId = 'rec_' + Utilities.getUuid().slice(0, 10);

  appendRow(dataSheet, DATA_COLS, {
    orgId: admin.orgId, recordId, ownerUserId: admin.userId, type: 'upgradeRequest',
    payload: JSON.stringify({
      orgName, fullName, email, phone,
      requestedPlan, requestedBillingCycle, requestedLabel: requestedLabel || `${PLAN_NAMES[requestedPlan]} — ${requestedBillingCycle}`,
      hasScreenshot: !!paymentScreenshotDataUrl,
      status: 'pending', submittedAt: nowIso, reviewedAt: null
    }),
    createdAt: nowIso, updatedAt: nowIso
  });

  // Email Victor with everything, screenshot attached — best effort.
  try {
    const attachments = [];
    if (paymentScreenshotDataUrl && paymentScreenshotDataUrl.indexOf(',') !== -1) {
      const [meta, base64] = paymentScreenshotDataUrl.split(',');
      const mimeMatch = /data:(.*);base64/.exec(meta);
      const mimeType = mimeMatch ? mimeMatch[1] : 'image/jpeg';
      attachments.push(Utilities.newBlob(Utilities.base64Decode(base64), mimeType, 'payment-screenshot.jpg'));
    }
    MailApp.sendEmail({
      to: OWNER_EMAIL,
      subject: `${APP_NAME} — New Upgrade Request: ${escapeHtml(orgName)}`,
      htmlBody: `
        <p>A new upgrade request was submitted.</p>
        <ul>
          <li><strong>Organization:</strong> ${escapeHtml(orgName)}</li>
          <li><strong>Contact:</strong> ${escapeHtml(fullName)} — ${escapeHtml(email)} — ${escapeHtml(phone)}</li>
          <li><strong>Requested plan:</strong> ${escapeHtml(requestedLabel || requestedPlan)}</li>
          <li><strong>Org ID:</strong> ${admin.orgId}</li>
        </ul>
        <p>To confirm: open the Super Admin dashboard's <strong>Upgrade Approvals</strong> panel and approve or reject this request. The customer will be emailed automatically and their dashboard will update on next login/sync.</p>
      `,
      attachments: attachments
    });
  } catch (err) { /* best-effort */ }

  return { ok: true };
}

/**
 * DEPRECATED as of the per-tenant-spreadsheet architecture. Each org's Users tab now
 * lives in that org's own spreadsheet file, so a simple trigger bound to one spreadsheet
 * can no longer watch every org's "upgradeReviewStatus" cell in one place. Left here as a
 * harmless no-op in case a trigger reference to it still exists — the review workflow is
 * now handlePlatformListPendingUpgrades / handlePlatformReviewUpgrade below, surfaced as
 * an "Upgrade Approvals" panel on the Super Admin dashboard instead of a sheet edit.
 */
function onEdit(e) {
  // Intentionally does nothing. See comment above.
}

// Centralized upgrade approvals — replaces the old onEdit-cell-watch flow with an explicit
// Super Admin dashboard action, since there's no longer one shared sheet to watch.
function handlePlatformListPendingUpgrades(body, admin) {
  const pending = [];
  listTenantOrgIds().forEach(orgId => {
    try {
      const dataRows = readRows(getSheet(DATA_SHEET, orgId), DATA_COLS);
      dataRows.filter(r => r.type === 'upgradeRequest' && safeParse(r.payload).status === 'pending')
        .forEach(r => pending.push({ orgId, recordId: r.recordId, ...safeParse(r.payload) }));
    } catch (err) { /* skip an unreachable tenant rather than failing the whole list */ }
  });
  pending.sort((a, b) => new Date(b.submittedAt) - new Date(a.submittedAt));
  return { ok: true, pending };
}

function handlePlatformReviewUpgrade(body, admin) {
  const { orgId, recordId, decision } = body; // decision: 'confirmed' | 'rejected'
  if (!orgId || !recordId || (decision !== 'confirmed' && decision !== 'rejected')) {
    return { ok: false, error: 'Missing or invalid fields' };
  }
  const dataSheet = getSheet(DATA_SHEET, orgId);
  const dataRows = readRows(dataSheet, DATA_COLS);
  const latestIdx = dataRows.findIndex(r => r.recordId === recordId && r.type === 'upgradeRequest');
  if (latestIdx === -1) return { ok: false, error: 'Upgrade request not found' };
  const reqPayload = safeParse(dataRows[latestIdx].payload);
  if (reqPayload.status !== 'pending') return { ok: false, error: 'This request has already been reviewed' };
  const nowIso = new Date().toISOString();

  if (decision === 'confirmed') {
    const cycleDays = BILLING_CYCLE_DAYS[reqPayload.requestedBillingCycle] || 30;
    const expiry = new Date(Date.now() + cycleDays * 24 * 60 * 60 * 1000);
    const userSheet = getSheet(USERS_SHEET, orgId);
    const userRows = readRows(userSheet, USER_COLS);
    const userIdx = userRows.findIndex(r => rolesToArray(r.roles).includes('Super Administrator'));
    if (userIdx !== -1) {
      updateRow(userSheet, USER_COLS, userIdx, {
        subscriptionStatus: 'active', plan: reqPayload.requestedPlan, billingCycle: reqPayload.requestedBillingCycle,
        subscriptionStartDate: nowIso, subscriptionExpiry: expiry.toISOString()
      });
    }
    updateRow(dataSheet, DATA_COLS, latestIdx, {
      payload: JSON.stringify({ ...reqPayload, status: 'confirmed', reviewedAt: nowIso }), updatedAt: nowIso
    });
    try {
      MailApp.sendEmail(platformEmailOptions({
        to: reqPayload.email,
        subject: `${APP_NAME} — You're Upgraded! (${reqPayload.requestedLabel})`,
        htmlBody: `
          <p>Hi ${escapeHtml(reqPayload.fullName)},</p>
          <p>Your payment has been confirmed and <strong>${escapeHtml(reqPayload.orgName)}</strong> is now upgraded to <strong>${escapeHtml(reqPayload.requestedLabel)}</strong>.</p>
          <p><strong>Start date:</strong> ${new Date(nowIso).toDateString()}<br>
          <strong>Due date:</strong> ${expiry.toDateString()}</p>
          <p>Your dashboard will show the days/weeks/months remaining automatically. Thank you!</p>
        `
      }));
    } catch (err) { /* best-effort */ }
  } else {
    updateRow(dataSheet, DATA_COLS, latestIdx, {
      payload: JSON.stringify({ ...reqPayload, status: 'rejected', reviewedAt: nowIso }), updatedAt: nowIso
    });
    try {
      MailApp.sendEmail(platformEmailOptions({
        to: reqPayload.email,
        subject: `${APP_NAME} — Upgrade Request Update`,
        htmlBody: `
          <p>Hi ${escapeHtml(reqPayload.fullName)},</p>
          <p>We could not confirm your payment for <strong>${escapeHtml(reqPayload.requestedLabel)}</strong>. Please contact us at ${OWNER_EMAIL} or ${OWNER_PHONE} so we can help sort this out.</p>
        `
      }));
    } catch (err) { /* best-effort */ }
  }

  return { ok: true, status: decision };
}

