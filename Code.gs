/* ============================== SIGNUP / LOGIN ============================== */

function handleSignup(body) {
  const { username, email, passwordHash, fullName, orgName, phone, plan, billingCycle } = body;
  if (!username || !email || !passwordHash || !fullName || !orgName) {
    return { ok: false, error: 'Please fill in every field.' };
  }

  // Username/email uniqueness is now checked against the global AuthIndex on the master
  // spreadsheet, since each org's Users tab only sees its own org's rows.
  if (authIndexFind(username)) return { ok: false, error: 'Username already taken' };
  if (authIndexFind(email)) return { ok: false, error: 'Email already registered' };

  const orgId = 'org_' + Utilities.getUuid().slice(0, 8);
  const userId = 'usr_' + Utilities.getUuid().slice(0, 8);
  const now = new Date();
  const nowIso = now.toISOString();
  const trialEnd = new Date(now.getTime() + TRIAL_DAYS * 24 * 60 * 60 * 1000);
  const planKey = PLAN_NAMES[plan] ? plan : 'essentials';

  // Creates the tenant's own spreadsheet (Users/Data tabs) and registers it in the master
  // TenantRegistry — see Tenancy.gs.
  createTenantSpreadsheet(orgId, orgName, { plan: planKey, billingCycle: billingCycle || 'monthly' });
  const sheet = getSheet(USERS_SHEET, orgId);

  appendRow(sheet, USER_COLS, {
    orgId, userId, roles: 'Super Administrator', fullName,
    username, email, passwordHash,
    subscriptionStatus: 'trial',       // 7-day free trial, no payment gate yet
    subscriptionExpiry: '',
    resetToken: '', resetTokenExpiry: '',
    sessionToken: '', sessionExpiry: '',
    createdAt: nowIso, active: 'TRUE',
    orgName, phone: phone || '', plan: planKey, billingCycle: billingCycle || 'monthly',
    trialStartDate: nowIso, trialEndDate: trialEnd.toISOString()
  });
  authIndexAdd(username, email, orgId);

  // Welcome email — best effort; a MailApp quota issue shouldn't fail the signup itself.
  try {
    MailApp.sendEmail(platformEmailOptions({
      to: email,
      subject: `Welcome to ${APP_NAME} — Your 7-Day Free Trial Has Started`,
      htmlBody: `
        <p>Hi ${escapeHtml(fullName)},</p>
        <p><strong>${escapeHtml(orgName)}</strong> is now set up on ${APP_NAME}, on the <strong>${PLAN_NAMES[planKey]}</strong> plan (${escapeHtml(billingCycle || 'monthly')} billing) — with full access for the next 7 days, free.</p>
        <p><strong>Username:</strong> ${escapeHtml(username)}</p>
        <p>Next: install the app and log in to get started. Your trial ends on ${trialEnd.toDateString()} — you'll see a countdown and an upgrade option right on your dashboard the whole time.</p>
      `
    }));
  } catch (err) { /* best-effort */ }

  return { ok: true, orgId, userId, roles: ['Super Administrator'], trialEndDate: trialEnd.toISOString() };
}

function handleLogin(body) {
  const { username, passwordHash } = body;
  // Step 1: route to the right tenant spreadsheet via the master AuthIndex (login doesn't
  // know the orgId up front — that's the whole point of the index).
  const orgId = authIndexFind(username);
  if (!orgId) return { ok: false, error: 'No account found' };
  const sheet = getSheet(USERS_SHEET, orgId);
  const rows = readRows(sheet, USER_COLS);
  const idx = rows.findIndex(r =>
    r.username.toLowerCase() === String(username || '').toLowerCase() ||
    r.email.toLowerCase() === String(username || '').toLowerCase()
  );
  if (idx === -1) return { ok: false, error: 'No account found' };
  const user = rows[idx];

  if (String(user.active).toUpperCase() !== 'TRUE') return { ok: false, error: 'Account disabled' };
  if (user.passwordHash !== passwordHash) return { ok: false, error: 'Incorrect password' };

  // The platform account (Victor/OKV Technology) has no subscription of its own to check —
  // it sits outside every school's org, gated only by the role itself.
  if (user.orgId === PLATFORM_ORG_ID && rolesToArray(user.roles).includes(PLATFORM_ROLE)) {
    const token = makeSessionToken(user.orgId);
    const expiry = new Date(Date.now() + SESSION_TTL_MS).toISOString();
    updateRow(sheet, USER_COLS, idx, { sessionToken: token, sessionExpiry: expiry });
    return {
      ok: true, sessionToken: token, orgId: user.orgId, userId: user.userId,
      roles: rolesToArray(user.roles), fullName: user.fullName, username: user.username,
      isPlatformAdmin: true
    };
  }

  // Subscription/trial status is org-wide, not per-user — it lives on the org's
  // Super Administrator row, and gates every user in that org, not just the Admin.
  const billingRow = rows.find(r => r.orgId === user.orgId && rolesToArray(r.roles).includes('Super Administrator')) || user;
  if (billingRow.subscriptionStatus === 'trial') {
    if (billingRow.trialEndDate && new Date(billingRow.trialEndDate).getTime() < Date.now()) {
      return { ok: false, error: 'Your 7-day free trial has ended. Visit the pricing page to upgrade and keep using ' + APP_NAME + '.' };
    }
  } else if (billingRow.subscriptionStatus === 'active') {
    if (billingRow.subscriptionExpiry && new Date(billingRow.subscriptionExpiry).getTime() < Date.now()) {
      return { ok: false, error: 'Your subscription has expired. Please renew from the Upgrade page to keep using ' + APP_NAME + '.' };
    }
  } else {
    return { ok: false, error: 'Subscription inactive. Contact your administrator.' };
  }

  const token = makeSessionToken(user.orgId);
  const expiry = new Date(Date.now() + SESSION_TTL_MS).toISOString();
  updateRow(sheet, USER_COLS, idx, { sessionToken: token, sessionExpiry: expiry });

  return {
    ok: true, sessionToken: token, orgId: user.orgId, userId: user.userId,
    roles: rolesToArray(user.roles), fullName: user.fullName, username: user.username,
    subscriptionStatus: billingRow.subscriptionStatus, plan: billingRow.plan || '',
    billingCycle: billingRow.billingCycle || '', trialEndDate: billingRow.trialEndDate || '',
    subscriptionExpiry: billingRow.subscriptionExpiry || '', orgName: billingRow.orgName || '',
    orgEmail: billingRow.email || '', orgPhone: billingRow.phone || '',
    subscriptionStartDate: billingRow.subscriptionStartDate || '',
    assignedSchoolIds: rolesToArray(user.assignedSchoolIds)
  };
}

function handleLogout(body) {
  const orgId = orgIdFromToken(body.sessionToken);
  if (!orgId) return { ok: true }; // malformed/unknown token — nothing to do
  const sheet = getSheet(USERS_SHEET, orgId);
  const rows = readRows(sheet, USER_COLS);
  const idx = rows.findIndex(r => r.sessionToken === body.sessionToken);
  if (idx !== -1) updateRow(sheet, USER_COLS, idx, { sessionToken: '', sessionExpiry: '' });
  return { ok: true };
}

/* ============================== SESSION HELPERS ============================== */
/* Session/reset tokens are minted as "<orgId>::tok_<uuid>" (see makeSessionToken /
   makeResetToken in Tenancy.gs). That lets us jump straight to the right tenant
   spreadsheet without a global lookup table of live tokens — the token itself carries
   its routing, while the random UUID half still has to match exactly for the session
   to resolve, so security is unchanged. */

function orgIdFromToken(token) {
  const parts = String(token || '').split('::');
  return parts.length === 2 && parts[0] ? parts[0] : null;
}

function resolveSession(sessionToken) {
  const orgId = orgIdFromToken(sessionToken);
  if (!orgId) return null;
  let sheet;
  try { sheet = getSheet(USERS_SHEET, orgId); } catch (err) { return null; }
  const rows = readRows(sheet, USER_COLS);
  const idx = rows.findIndex(r => r.sessionToken === sessionToken);
  if (idx === -1) return null;
  const user = rows[idx];
  if (!user.sessionExpiry || new Date(user.sessionExpiry).getTime() < Date.now()) return null;
  return { user, idx, sheet };
}

function withSession(body, fn) {
  const s = resolveSession(body.sessionToken);
  if (!s) return { ok: false, error: 'Session expired. Please log in again.' };
  return fn(body, s.user, s.idx, s.sheet);
}

function withAdminSession(body, fn) {
  const s = resolveSession(body.sessionToken);
  if (!s) return { ok: false, error: 'Session expired. Please log in again.' };
  if (!isAdminTier(s.user.roles)) return { ok: false, error: 'Admin access required' };
  return fn(body, s.user, s.idx, s.sheet);
}

const FINANCE_ROLES = ['Super Administrator', 'School Administrator', 'Bursar / Accountant'];
function withFinanceSession(body, fn) {
  const s = resolveSession(body.sessionToken);
  if (!s) return { ok: false, error: 'Session expired. Please log in again.' };
  if (!rolesToArray(s.user.roles).some(r => FINANCE_ROLES.includes(r))) {
    return { ok: false, error: 'Bursar or Admin access required' };
  }
  return fn(body, s.user, s.idx, s.sheet);
}

function withPlatformSession(body, fn) {
  const s = resolveSession(body.sessionToken);
  if (!s) return { ok: false, error: 'Session expired. Please log in again.' };
  if (s.user.orgId !== PLATFORM_ORG_ID || !rolesToArray(s.user.roles).includes(PLATFORM_ROLE)) {
    return { ok: false, error: 'Platform admin access required' };
  }
  return fn(body, s.user, s.idx, s.sheet);
}

/* ============================== ONE-TIME SETUP (run these two, in order) ============================== */

// STEP 1 of 2. Run ONCE from the Apps Script editor (function dropdown > Run, then allow access).
// Creates the Google Sheet that holds all system data, with every tab and header row, and
// stores its ID. Nothing is created by hand. Safe to re-run: it only adds what is missing.
// The sheet link is written to the Execution log (View > Logs).
function createDataSheet() {
  const ss = initMasterSpreadsheet();
  const url = ss.getUrl();
  Logger.log('Data sheet ready: ' + url);
  return url;
}

// STEP 2 of 2. Run ONCE after createDataSheet. Creates the platform owner login.
// Change OWNER_PASSWORD below BEFORE running. Safe to re-run: it never creates a duplicate.
function createOwnerAccount() {
  const OWNER_PASSWORD = 'OKVSMS557'; // change me before running; you can change it later from "Forgot password"
  createDataSheet(); // no-op if the data sheet already exists
  const sheet = getSheet(USERS_SHEET, PLATFORM_ORG_ID);
  const rows = readRows(sheet, USER_COLS);
  if (rows.some(r => r.orgId === PLATFORM_ORG_ID)) {
    Logger.log('Platform admin already exists — nothing to do.');
    return;
  }
  const passwordHash = Utilities.computeDigest(Utilities.DigestAlgorithm.SHA_256, OWNER_PASSWORD)
    .map(b => (b < 0 ? b + 256 : b).toString(16).padStart(2, '0')).join('');
  appendRow(sheet, USER_COLS, {
    orgId: PLATFORM_ORG_ID, userId: 'usr_platform', roles: PLATFORM_ROLE,
    fullName: 'OKV Technology', username: OWNER_EMAIL, email: OWNER_EMAIL,
    passwordHash, subscriptionStatus: 'active', active: 'TRUE',
    createdAt: new Date().toISOString()
  });
  authIndexAdd(OWNER_EMAIL, OWNER_EMAIL, PLATFORM_ORG_ID);
  Logger.log('Platform admin created. Username: ' + OWNER_EMAIL + '  Password: ' + OWNER_PASSWORD);
}

// Kept so older setup notes still work. Same as createOwnerAccount().
function seedPlatformSuperAdmin() { return createOwnerAccount(); }

/* ============================== SUBSCRIPTION REMINDERS (twice a month) ============================== */
/* Set up ONE time-driven trigger on this function, running daily — it self-gates so it only
   actually sends on the 1st and 15th of the month, which is what keeps this from being a
   daily nag. In the Apps Script editor: Triggers (clock icon) → Add Trigger → function
   "sendSubscriptionReminders" → Time-driven → Day timer → whatever hour you prefer. */
function sendSubscriptionReminders() {
  const today = new Date();
  const dayOfMonth = today.getDate();
  if (dayOfMonth !== 1 && dayOfMonth !== 15) return; // twice a month, not a daily nag

  // Per-tenant spreadsheets: loop every registered org's own Users tab and collect its
  // Super Administrator row (there's exactly one billing-relevant row per org).
  const orgAdmins = [];
  listTenantOrgIds().forEach(orgId => {
    try {
      const sheet = getSheet(USERS_SHEET, orgId);
      const rows = readRows(sheet, USER_COLS);
      rows.filter(r => rolesToArray(r.roles).includes('Super Administrator')).forEach(r => orgAdmins.push(r));
    } catch (err) { /* a tenant sheet that failed to open shouldn't block the others */ }
  });

  orgAdmins.forEach(admin => {
    if (!admin.email) return;
    const status = admin.subscriptionStatus;
    let dueDate = null, situation = '';

    if (status === 'trial' && admin.trialEndDate) {
      dueDate = new Date(admin.trialEndDate);
      situation = 'trial';
    } else if (status === 'active' && admin.subscriptionExpiry) {
      dueDate = new Date(admin.subscriptionExpiry);
      situation = 'renewal';
    } else {
      return; // no dated status to remind about (e.g. no expiry set yet, or already expired/cancelled)
    }

    const daysLeft = Math.ceil((dueDate.getTime() - Date.now()) / (24 * 60 * 60 * 1000));
    if (daysLeft < 0 || daysLeft > 14) return; // only nudge when it's genuinely close — within 2 weeks

    const planLabel = PLAN_NAMES[admin.plan] || admin.plan || 'your current plan';
    const cycleLabel = { monthly: 'Monthly', biannual: 'Bi-Annual', yearly: 'Yearly' }[admin.billingCycle] || admin.billingCycle || '';
    const situationLine = situation === 'trial'
      ? (daysLeft > 0 ? `Your 7-day free trial ends in ${daysLeft} day${daysLeft === 1 ? '' : 's'}.` : 'Your 7-day free trial ends today.')
      : (daysLeft > 0 ? `Your ${planLabel} ${cycleLabel} subscription is due for renewal in ${daysLeft} day${daysLeft === 1 ? '' : 's'}.` : 'Your subscription renewal is due today.');

    try {
      MailApp.sendEmail(platformEmailOptions({
        to: admin.email,
        subject: `${APP_NAME} — ${situation === 'trial' ? 'Trial ending soon' : 'Renewal coming up'}`,
        htmlBody: `
          <p>Hi ${escapeHtml(admin.fullName)},</p>
          <p>${situationLine}</p>
          <p>You're currently on <strong>${escapeHtml(planLabel)} (${escapeHtml(cycleLabel)})</strong>. To keep everything running without interruption:</p>
          <ol>
            <li>Open your dashboard and click the <strong>Upgrade</strong> icon.</li>
            <li>Pick ${escapeHtml(planLabel)} (or a different tier, if your needs have changed) and the billing cycle that suits you.</li>
            <li>Make the bank transfer using the account details shown, and upload your payment screenshot.</li>
            <li>You'll get a confirmation email once it's reviewed — usually within the hour.</li>
          </ol>
          <p>Questions? Reach us at ${OWNER_EMAIL} or ${OWNER_PHONE}.</p>
        `
      }));
    } catch (err) { /* best-effort; one failed email shouldn't stop the rest */ }
  });
}

const COMMS_ROLES = ['Super Administrator', 'School Administrator', 'Principal / Head Teacher', 'Academic Officer / Exam Officer', 'Teacher'];
function withCommsSession(body, fn) {
  const s = resolveSession(body.sessionToken);
  if (!s) return { ok: false, error: 'Session expired. Please log in again.' };
  if (!rolesToArray(s.user.roles).some(r => COMMS_ROLES.includes(r))) {
    return { ok: false, error: 'Not permitted to send parent communications' };
  }
  return fn(body, s.user, s.idx, s.sheet);
}

const EXAM_OFFICER_ROLES = ['Super Administrator','School Administrator','Principal / Head Teacher','Academic Officer / Exam Officer'];
function withExamOfficerSession(body, fn) {
  const s = resolveSession(body.sessionToken);
  if (!s) return { ok: false, error: 'Session expired. Please log in again.' };
  if (!rolesToArray(s.user.roles).some(r => EXAM_OFFICER_ROLES.includes(r))) {
    return { ok: false, error: 'Admin or Exam Officer access required' };
  }
  return fn(body, s.user, s.idx, s.sheet);
}

/* ============================== ROLE HELPERS ============================== */

function rolesToArray(rolesStr) {
  return String(rolesStr || '').split(',').map(r => r.trim()).filter(Boolean);
}
function rolesToString(rolesArr) {
  return (rolesArr || []).map(r => String(r).trim()).filter(Boolean).join(',');
}
function isAdminTier(rolesStr) {
  const arr = rolesToArray(rolesStr);
  return arr.some(r => ADMIN_TIER_ROLES.includes(r));
}
function sanitizeRoles(rolesArr) {
  if (!Array.isArray(rolesArr)) return [];
  const clean = rolesArr.filter(r => ALL_ROLES.includes(r));
  return [...new Set(clean)];
}

/* ============================== ADMIN: USER MANAGEMENT ============================== */

function handleListUsers(body, admin) {
  const sheet = getSheet(USERS_SHEET, admin.orgId);
  const rows = readRows(sheet, USER_COLS);
  const users = rows
    .filter(r => r.orgId === admin.orgId)
    .map(r => ({
      userId: r.userId, roles: rolesToArray(r.roles), fullName: r.fullName, username: r.username,
      email: r.email, subscriptionStatus: r.subscriptionStatus, active: r.active, createdAt: r.createdAt,
      assignedSchoolIds: rolesToArray(r.assignedSchoolIds)
    }));
  return { ok: true, users, allRoles: ALL_ROLES };
}

// Lightweight user directory for linking purposes (e.g. staff records to login accounts).
// Available to a broader set of roles than the full admin panel, but returns minimal fields only.
function handleListOrgUsersBasic(body, user) {
  const allowedRoles = ['Super Administrator','School Administrator','Principal / Head Teacher','Academic Officer / Exam Officer','Teacher'];
  if (!rolesToArray(user.roles).some(r => allowedRoles.includes(r))) return { ok: false, error: 'Not permitted' };
  const sheet = getSheet(USERS_SHEET, user.orgId);
  const rows = readRows(sheet, USER_COLS);
  const users = rows.filter(r => r.orgId === user.orgId)
    .map(r => ({ userId: r.userId, fullName: r.fullName, username: r.username, roles: rolesToArray(r.roles) }));
  return { ok: true, users };
}

function handleCreateUser(body, admin) {
  const { username, email, passwordHash, fullName, roles, assignedSchoolIds } = body;
  if (!username || !passwordHash) return { ok: false, error: 'Missing fields' };
  const cleanRoles = sanitizeRoles(roles);
  if (!cleanRoles.length) return { ok: false, error: 'Select at least one role' };
  // Username uniqueness is global (via AuthIndex), since login has to route by username alone.
  if (authIndexFind(username)) return { ok: false, error: 'Username already taken' };
  const sheet = getSheet(USERS_SHEET, admin.orgId);
  const userId = 'usr_' + Utilities.getUuid().slice(0, 8);
  appendRow(sheet, USER_COLS, {
    orgId: admin.orgId, userId, roles: rolesToString(cleanRoles),
    fullName: fullName || username, username, email: email || '',
    passwordHash, subscriptionStatus: 'active', subscriptionExpiry: '',
    resetToken: '', resetTokenExpiry: '', sessionToken: '', sessionExpiry: '',
    createdAt: new Date().toISOString(), active: 'TRUE',
    assignedSchoolIds: rolesToString(Array.isArray(assignedSchoolIds) ? assignedSchoolIds : [])
  });
  authIndexAdd(username, email || '', admin.orgId);
  return { ok: true, userId };
}

function handleEditUser(body, admin) {
  const { targetUserId, fullName, email, roles, active, assignedSchoolIds } = body;
  if (active === false && targetUserId === admin.userId) return { ok: false, error: 'You cannot suspend your own account' };
  const sheet = getSheet(USERS_SHEET, admin.orgId);
  const rows = readRows(sheet, USER_COLS);
  const idx = rows.findIndex(r => r.userId === targetUserId && r.orgId === admin.orgId);
  if (idx === -1) return { ok: false, error: 'User not found in your organization' };

  const updates = {};
  if (fullName !== undefined) updates.fullName = fullName;
  if (email !== undefined) updates.email = email;
  if (assignedSchoolIds !== undefined) updates.assignedSchoolIds = rolesToString(Array.isArray(assignedSchoolIds) ? assignedSchoolIds : []);

  if (roles !== undefined) {
    const cleanRoles = sanitizeRoles(roles);
    if (!cleanRoles.length) return { ok: false, error: 'A user must have at least one role' };

    // Safety: don't let the last Super Administrator in the org lose that role.
    const wasSuperAdmin = rolesToArray(rows[idx].roles).includes('Super Administrator');
    const staysSuperAdmin = cleanRoles.includes('Super Administrator');
    if (wasSuperAdmin && !staysSuperAdmin) {
      const otherSuperAdmins = rows.filter((r, i) => i !== idx && r.orgId === admin.orgId &&
        rolesToArray(r.roles).includes('Super Administrator'));
      if (!otherSuperAdmins.length) {
        return { ok: false, error: 'Cannot remove the last Super Administrator in your organization' };
      }
    }
    updates.roles = rolesToString(cleanRoles);
  }
  if (active !== undefined) updates.active = active ? 'TRUE' : 'FALSE';
  updateRow(sheet, USER_COLS, idx, updates);
  return { ok: true };
}

function handleDeleteUser(body, admin) {
  const { targetUserId } = body;
  if (targetUserId === admin.userId) return { ok: false, error: 'Cannot delete your own account' };
  const sheet = getSheet(USERS_SHEET, admin.orgId);
  const rows = readRows(sheet, USER_COLS);
  const idx = rows.findIndex(r => r.userId === targetUserId && r.orgId === admin.orgId);
  if (idx === -1) return { ok: false, error: 'User not found in your organization' };
  authIndexRemove(rows[idx].username, rows[idx].email);
  sheet.deleteRow(idx + 2); // +2: header row + 1-index
  return { ok: true };
}

function handleSetUserPassword(body, admin) {
  const { targetUserId, newPasswordHash } = body;
  if (!newPasswordHash) return { ok: false, error: 'Missing new password' };
  const sheet = getSheet(USERS_SHEET, admin.orgId);
  const rows = readRows(sheet, USER_COLS);
  const idx = rows.findIndex(r => r.userId === targetUserId && r.orgId === admin.orgId);
  if (idx === -1) return { ok: false, error: 'User not found in your organization' };
  updateRow(sheet, USER_COLS, idx, { passwordHash: newPasswordHash, sessionToken: '', sessionExpiry: '' });
  return { ok: true };
}

// Self-service — any logged-in user (Admin or User) changing their OWN password.
function handleChangePassword(body, user, idx, sheet) {
  const { currentPasswordHash, newPasswordHash } = body;
  if (!currentPasswordHash || !newPasswordHash) return { ok: false, error: 'Missing fields' };
  if (user.passwordHash !== currentPasswordHash) return { ok: false, error: 'Current password is incorrect' };
  updateRow(sheet, USER_COLS, idx, { passwordHash: newPasswordHash });
  return { ok: true };
}

function handleBulkImportUsers(body, admin) {
  const rows = Array.isArray(body.rows) ? body.rows : [];
  if (!rows.length) return { ok: false, error: 'No rows provided' };

  const sheet = getSheet(USERS_SHEET, admin.orgId);
  const now = new Date().toISOString();

  const created = [];
  const skipped = [];

  rows.forEach(row => {
    const username = String(row.username || '').trim();
    const fullName = String(row.fullName || '').trim();
    const passwordHash = row.passwordHash;
    if (!username || !fullName || !passwordHash) {
      skipped.push({ username: username || '(blank)', reason: 'Missing required field' });
      return;
    }
    // Global check via AuthIndex (username has to be unique across every org for login routing).
    if (authIndexFind(username)) {
      skipped.push({ username, reason: 'Username already exists' });
      return;
    }
    const cleanRoles = sanitizeRoles(row.roles && row.roles.length ? row.roles : ['Result Viewer / Parent Portal User']);
    const userId = 'usr_' + Utilities.getUuid().slice(0, 8);
    appendRow(sheet, USER_COLS, {
      orgId: admin.orgId, userId, roles: rolesToString(cleanRoles),
      fullName, username, email: row.email || '', passwordHash,
      subscriptionStatus: 'active', subscriptionExpiry: '',
      resetToken: '', resetTokenExpiry: '', sessionToken: '', sessionExpiry: '',
      createdAt: now, active: 'TRUE'
    });
    authIndexAdd(username, row.email || '', admin.orgId);
    created.push(username);
  });

  return { ok: true, created, skipped };
}

/* ============================== PASSWORD RESET (Admin, email-based) ============================== */

function handleForgotPassword(body) {
  const { email } = body;
  const orgId = authIndexFind(email);
  // Always return ok:true even if not found, so the UI can't be used to enumerate accounts.
  if (!orgId) return { ok: true };
  const sheet = getSheet(USERS_SHEET, orgId);
  const rows = readRows(sheet, USER_COLS);
  const idx = rows.findIndex(r =>
    r.email.toLowerCase() === String(email || '').toLowerCase() && isAdminTier(r.roles)
  );
  if (idx === -1) return { ok: true };

  const user = rows[idx];
  const token = makeResetToken(orgId);
  const expiry = new Date(Date.now() + RESET_TTL_MS).toISOString();
  updateRow(sheet, USER_COLS, idx, { resetToken: token, resetTokenExpiry: expiry });

  const link = `${RESET_PASSWORD_URL}?token=${encodeURIComponent(token)}`;
  MailApp.sendEmail(platformEmailOptions({
    to: user.email,
    subject: `${APP_NAME} — Password Reset`,
    htmlBody: `
      <p>Hello ${escapeHtml(user.fullName || user.username)},</p>
      <p>We received a request to reset your ${APP_NAME} password. This link expires in 30 minutes and can only be used once.</p>
      <p><a href="${link}">Reset your password</a></p>
      <p>If you didn't request this, you can safely ignore this email.</p>
    `
  }));
  return { ok: true };
}

function handleResetPassword(body) {
  const { token, newPasswordHash } = body;
  if (!token || !newPasswordHash) return { ok: false, error: 'Missing fields' };
  const orgId = orgIdFromToken(token);
  if (!orgId) return { ok: false, error: 'Invalid or already-used reset link' };
  const sheet = getSheet(USERS_SHEET, orgId);
  const rows = readRows(sheet, USER_COLS);
  const idx = rows.findIndex(r => r.resetToken === token);
  if (idx === -1) return { ok: false, error: 'Invalid or already-used reset link' };
  const user = rows[idx];
  if (!user.resetTokenExpiry || new Date(user.resetTokenExpiry).getTime() < Date.now()) {
    return { ok: false, error: 'This reset link has expired. Please request a new one.' };
  }
  updateRow(sheet, USER_COLS, idx, {
    passwordHash: newPasswordHash, resetToken: '', resetTokenExpiry: '',
    sessionToken: '', sessionExpiry: ''
  });
  return { ok: true };
}

/* ============================== DATA (generic, org+owner scoped) ============================== */
/* Phase 2+ will build student/score/etc. record types on top of this. */

function handleGetData(body, user) {
  // Fast path for the common case (paged pull, no per-type filter): works from five narrow columns instead of
  // reading every payload in the sheet, so an "anything new?" check stays cheap however many years of records exist.
  if (body.paged && !body.type) {
    const fast = tryFastPagedPull(body, user);
    if (fast) return fast;
  }
  const sheet = getSheet(DATA_SHEET, user.orgId);
  const rows = readRows(sheet, DATA_COLS);
  let scoped = rows.filter(r => r.orgId === user.orgId && !GENERIC_DATA_BLOCKED_TYPES.includes(r.type));
  if (body.type) {
    if (GENERIC_DATA_BLOCKED_TYPES.includes(body.type)) {
      return { ok: false, error: 'Use the dedicated messaging actions to read this data.' };
    }
    scoped = scoped.filter(r => r.type === body.type);
    if (!canReadType(user.roles, body.type)) {
      scoped = scoped.filter(r => r.ownerUserId === user.userId);
    }
  } else {
    // No type filter (e.g. a full sync pull) — apply per-type read rules record by record.
    // Blocked types were already stripped out above, before this fallback OR could re-admit
    // a sender's own sent messages by ownership.
    scoped = scoped.filter(r => canReadType(user.roles, r.type) || r.ownerUserId === user.userId);
  }

  // Multi-branch scoping: a record explicitly tagged with a schoolId (student/staff, mainly)
  // is only visible to admin-tier users or users assigned to that specific school/branch.
  // Records with no schoolId tag — every org that doesn't use multiple branches — are
  // completely unaffected by this; it's purely additive.
  if (!isAdminTier(user.roles)) {
    const mySchools = rolesToArray(user.assignedSchoolIds);
    scoped = scoped.filter(r => {
      const p = safeParse(r.payload);
      return !p.schoolId || mySchools.includes(p.schoolId);
    });
  }

  // `total` = how many records this user can see right now. A client that pulled incrementally
  // compares it with its own cache size; any difference (a record deleted or archived elsewhere)
  // tells it to do one full re-sync instead of trusting a partial picture.
  const total = scoped.length;

  // Paged + incremental pull (opt-in: old clients that don't send `paged` still get everything at once).
  // Records are ordered by (updatedAt, recordId); the client sends the cursor of the last record it has
  // (`since` in ms, plus `afterId`) and receives only what changed after it, PULL_PAGE_SIZE at a time.
  if (body.paged && !body.type) {
    const limit = Math.max(100, Math.min(Number(body.limit) || PULL_PAGE_SIZE, 5000));
    const hasSince = body.since !== undefined && body.since !== null && body.since !== '';
    const since = hasSince ? Number(body.since) : -1;
    const afterId = body.afterId ? String(body.afterId) : '';
    const stamped = scoped.map(r => ({ r, t: pullTimeMs(r) }));
    const fresh = hasSince ? stamped.filter(x => x.t > since || (x.t === since && x.r.recordId > afterId)) : stamped;
    fresh.sort((a, b) => (a.t - b.t) || (a.r.recordId < b.r.recordId ? -1 : a.r.recordId > b.r.recordId ? 1 : 0));
    const page = fresh.slice(0, limit);
    const last = page.length ? page[page.length - 1] : null;
    return {
      ok: true, paged: true, total, hasMore: fresh.length > limit,
      cursor: last ? { t: last.t, id: last.r.recordId } : null,
      serverTime: Date.now(),
      records: page.map(x => ({ ...x.r, payload: safeParse(x.r.payload) }))
    };
  }

  return { ok: true, total, records: scoped.map(r => ({ ...r, payload: safeParse(r.payload) })) };
}

/* Narrow-column version of the paged pull. Reads only orgId, recordId, owner, type and updatedAt for every row
   (all short values), decides what this user can see and what changed since their cursor from those alone, and
   then fetches full rows (with the big payload column) ONLY for the page being returned. Returns null when it
   can't give exactly the same answer as the full read (branch-scoped non-admin users in a multi-branch school,
   or unreadable timestamps), and the caller then uses the full read. The two paths are tested for identical output. */
function tryFastPagedPull(body, user) {
  const sheet = getSheet(DATA_SHEET, user.orgId);
  const lastRow = sheet.getLastRow();
  const emptyPage = { ok: true, paged: true, total: 0, hasMore: false, cursor: null, serverTime: Date.now(), records: [] };
  if (lastRow < 2) return emptyPage;
  const n = lastRow - 1;
  const iOrg = DATA_COLS.indexOf('orgId'), iId = DATA_COLS.indexOf('recordId'), iOwner = DATA_COLS.indexOf('ownerUserId');
  const iType = DATA_COLS.indexOf('type'), iUpd = DATA_COLS.indexOf('updatedAt');
  const head = sheet.getRange(2, iOrg + 1, n, iType - iOrg + 1).getValues();   // orgId..type are contiguous
  const upd = sheet.getRange(2, iUpd + 1, n, 1).getValues();

  // Multi-branch scoping needs each record's payload, so branch-restricted staff use the full read.
  if (!isAdminTier(user.roles)) {
    for (let i = 0; i < n; i++) {
      if (String(head[i][iType - iOrg]) !== 'settings' || String(head[i][0]) !== user.orgId) continue;
      const row = sheet.getRange(i + 2, 1, 1, DATA_COLS.length).getValues()[0];
      const s = safeParse(String(row[DATA_COLS.indexOf('payload')]));
      if (s && Array.isArray(s.schools) && s.schools.length) return null;
    }
  }

  const vis = [];
  for (let i = 0; i < n; i++) {
    const orgId = String(head[i][0]), recordId = String(head[i][iId - iOrg]), owner = String(head[i][iOwner - iOrg]), type = String(head[i][iType - iOrg]);
    if (orgId !== user.orgId || GENERIC_DATA_BLOCKED_TYPES.includes(type)) continue;
    if (!(canReadType(user.roles, type) || owner === user.userId)) continue;
    const t = new Date(String(upd[i][0])).getTime();
    if (isNaN(t)) return null;   // can't order this row from one column — let the full read handle it
    vis.push({ i, t, id: recordId });
  }
  const total = vis.length;
  const limit = Math.max(100, Math.min(Number(body.limit) || PULL_PAGE_SIZE, 5000));
  const hasSince = body.since !== undefined && body.since !== null && body.since !== '';
  const since = hasSince ? Number(body.since) : -1;
  const afterId = body.afterId ? String(body.afterId) : '';
  const fresh = hasSince ? vis.filter(x => x.t > since || (x.t === since && x.id > afterId)) : vis;
  fresh.sort((a, b) => (a.t - b.t) || (a.id < b.id ? -1 : a.id > b.id ? 1 : 0));
  const page = fresh.slice(0, limit);
  const last = page.length ? page[page.length - 1] : null;

  // Fetch full rows for just this page, in contiguous blocks (one read per block).
  const byIndex = {};
  const blocks = contiguousBlocks(page.map(x => x.i));
  if (blocks.length > 30) {
    sheet.getRange(2, 1, n, DATA_COLS.length).getValues().forEach((r, i) => { byIndex[i] = r; });
  } else {
    blocks.forEach(b => {
      sheet.getRange(b.start + 2, 1, b.count, DATA_COLS.length).getValues().forEach((r, k) => { byIndex[b.start + k] = r; });
    });
  }
  const records = page.map(x => {
    const r = byIndex[x.i], o = {};
    DATA_COLS.forEach((col, k) => { o[col] = r[k] === undefined ? '' : String(r[k]); });
    return { ...o, payload: safeParse(o.payload) };
  });
  return { ok: true, paged: true, total, hasMore: fresh.length > limit, cursor: last ? { t: last.t, id: last.id } : null, serverTime: Date.now(), records };
}

const PULL_PAGE_SIZE = 2000;

// Milliseconds for a record's last change; a row with unreadable timestamps counts as "just changed"
// so it is always re-sent rather than silently skipped.
// School identity + branding fields shared by every public payload that renders a printable
// (the result sheet and the portal header). Keeps the list in one place.
function publicBrandFields(settings) {
  return {
    schoolLogo2: settings.schoolLogo2 || '', schoolWebsite: settings.schoolWebsite || '', schoolRegNo: settings.schoolRegNo || '',
    brandPrimary: settings.brandPrimary || '', brandAccent: settings.brandAccent || '',
    printFooter: settings.printFooter || '', printWatermark: settings.printWatermark === true,
    gradingMethod: settings.gradingMethod === 'WAEC' ? 'WAEC' : 'AF'
  };
}

function pullTimeMs(r) {
  const n = new Date(r.updatedAt).getTime();
  if (!isNaN(n)) return n;
  const c = new Date(r.createdAt).getTime();
  return isNaN(c) ? Date.now() : c;
}

// Full-organization backup — admin-tier only, and deliberately NOT scoped by the normal
// per-type read-role rules (canReadType) the way getData is, since a backup is meant to be
// complete. Users are included but stripped of anything sensitive (password hashes, live
// session/reset tokens) — this is a downloadable file, not a permissions-scoped API response.
function handleExportBackup(body, admin) {
  const dataRows = readRows(getSheet(DATA_SHEET, admin.orgId), DATA_COLS)
    .filter(r => r.orgId === admin.orgId && !GENERIC_DATA_BLOCKED_TYPES.includes(r.type))
    .map(r => ({ recordId: r.recordId, type: r.type, payload: safeParse(r.payload), createdAt: r.createdAt, updatedAt: r.updatedAt }));

  const userRows = readRows(getSheet(USERS_SHEET, admin.orgId), USER_COLS)
    .filter(r => r.orgId === admin.orgId)
    .map(r => ({
      userId: r.userId, fullName: r.fullName, username: r.username, email: r.email,
      roles: rolesToArray(r.roles), active: r.active, createdAt: r.createdAt,
      assignedSchoolIds: rolesToArray(r.assignedSchoolIds), orgName: r.orgName || ''
      // passwordHash/sessionToken/resetToken intentionally omitted from any export.
    }));

  return {
    ok: true, exportedAt: new Date().toISOString(), orgId: admin.orgId,
    orgName: (userRows.find(u => u.roles.includes('Super Administrator')) || {}).orgName || '',
    users: userRows.map(({orgName, ...rest}) => rest), records: dataRows
  };
}

function handleSaveData(body, user) {
  return withDataLock(() => saveDataLocked(body, user));
}

// Finds a record's row by reading only the recordId column (not every payload in the sheet).
function findRowIndexById(sheet, recordId) {
  const lastRow = sheet.getLastRow();
  if (lastRow < 2) return -1;
  const ids = sheet.getRange(2, 2, lastRow - 1, 1).getValues();
  const want = String(recordId);
  for (let i = 0; i < ids.length; i++) if (String(ids[i][0]) === want) return i;
  return -1;
}

function readRowAt(sheet, cols, idx) {
  const vals = sheet.getRange(idx + 2, 1, 1, cols.length).getValues()[0];
  const o = {};
  cols.forEach((c, i) => o[c] = vals[i] === undefined ? '' : String(vals[i]));
  return o;
}

function saveDataLocked(body, user) {
  const { recordId, type, payload } = body;
  if (!type) return { ok: false, error: 'Missing type' };
  if (GENERIC_DATA_BLOCKED_TYPES.includes(type)) {
    return { ok: false, error: 'Use the dedicated messaging actions to write this data.' };
  }
  const allowed = canWriteType(user.roles, type) || (!DATA_WRITE_ROLES[type] && isAdminTier(user.roles));
  const sheet = getSheet(DATA_SHEET, user.orgId);
  const now = new Date().toISOString();

  if (recordId) {
    const idx = findRowIndexById(sheet, recordId);
    const row = idx === -1 ? null : readRowAt(sheet, DATA_COLS, idx);
    if (!row || row.orgId !== user.orgId) return { ok: false, error: 'Record not found' };
    if (GENERIC_DATA_BLOCKED_TYPES.includes(row.type)) {
      return { ok: false, error: 'Use the dedicated messaging actions to write this data.' };
    }
    const canEditThis = allowed || row.ownerUserId === user.userId;
    if (!canEditThis) return { ok: false, error: 'You do not have permission to edit this record' };
    if (row.type === 'student' && type === 'student') {
      const chk = checkAdmissionNumber(user.orgId, sheet, payload, recordId, row);
      if (chk.error) return { ok: false, permanent: true, error: chk.error };
      payload.admissionNo = chk.number;
      updateRow(sheet, DATA_COLS, idx, { payload: JSON.stringify(payload || {}), updatedAt: now });
      recordAdmissionNumber(user.orgId, sheet, recordId, chk.number);
      return { ok: true, recordId };
    }
    updateRow(sheet, DATA_COLS, idx, { payload: JSON.stringify(payload || {}), updatedAt: now });
    return { ok: true, recordId };
  }

  if (!allowed && DATA_WRITE_ROLES[type]) return { ok: false, error: 'You do not have permission to create this type of record' };

  const newId = 'rec_' + Utilities.getUuid().slice(0, 10);
  let studentNumber = null;
  if (type === 'student') {
    const chk = checkAdmissionNumber(user.orgId, sheet, payload, newId, null);
    if (chk.error) return { ok: false, permanent: true, error: chk.error };
    payload.admissionNo = chk.number;
    studentNumber = chk.number;
  }
  appendRow(sheet, DATA_COLS, {
    orgId: user.orgId, recordId: newId, ownerUserId: user.userId, type,
    payload: JSON.stringify(payload || {}), createdAt: now, updatedAt: now
  });
  if (studentNumber) recordAdmissionNumber(user.orgId, sheet, newId, studentNumber);
  return { ok: true, recordId: newId };
}

function handleDeleteData(body, user) {
  return withDataLock(() => deleteDataLocked(body, user));
}

function deleteDataLocked(body, user) {
  const { recordId } = body;
  const sheet = getSheet(DATA_SHEET, user.orgId);
  const idx = findRowIndexById(sheet, recordId);
  const row = idx === -1 ? null : readRowAt(sheet, DATA_COLS, idx);
  if (!row || row.orgId !== user.orgId) return { ok: false, error: 'Record not found' };
  if (GENERIC_DATA_BLOCKED_TYPES.includes(row.type)) {
    return { ok: false, error: 'Messages cannot be deleted through this action.' };
  }
  const allowed = canWriteType(user.roles, row.type) || (!DATA_WRITE_ROLES[row.type] && isAdminTier(user.roles)) || row.ownerUserId === user.userId;
  if (!allowed) return { ok: false, error: 'You do not have permission to delete this record' };
  sheet.deleteRow(idx + 2);
  if (row.type === 'student') { try { CacheService.getScriptCache().remove(admCacheKey(user.orgId)); } catch (e) {} }
  return { ok: true };
}

/* ============================== UNIQUE ADMISSION NUMBERS ==============================
   An admission number belongs to ONE student for life. Promotion and repeating only change the student's class
   on the SAME record (the number never changes), and a number stays reserved after a student leaves or is made
   inactive, so it can never be handed to a different child. The server enforces this on every save, however the
   record arrives (page, CSV import, offline sync), by comparing against an index of every number in the school. */
const ADM_CACHE_SECONDS = 21600;   // the index is rebuilt from the sheet at least every 6 hours

// Canonical form: capital letters, no spaces. "okv/2026/ 0142" and "OKV/2026/0142" are the same number.
function normAdm(s) { return String(s == null ? '' : s).toUpperCase().replace(/\s+/g, ''); }

function admCacheKey(orgId) { return ('adm|' + orgId).slice(0, 200); }

// { NORMALISED_NUMBER: recordId } for every student in the org (active or not). Cached; rebuilt when missing.
function loadAdmissionIndex(orgId, sheet) {
  try {
    const hit = CacheService.getScriptCache().get(admCacheKey(orgId));
    if (hit) return JSON.parse(hit);
  } catch (e) { /* no cache available: rebuild below */ }
  const idx = {};
  const lastRow = sheet.getLastRow();
  if (lastRow >= 2) {
    const n = lastRow - 1;
    const iType = DATA_COLS.indexOf('type'), iId = DATA_COLS.indexOf('recordId'), iOrg = DATA_COLS.indexOf('orgId');
    const head = sheet.getRange(2, 1, n, iType + 1).getValues();
    const studentRows = [];
    for (let i = 0; i < n; i++) if (String(head[i][iType]) === 'student' && String(head[i][iOrg]) === orgId) studentRows.push(i);
    contiguousBlocks(studentRows).forEach(b => {
      sheet.getRange(b.start + 2, 1, b.count, DATA_COLS.length).getValues().forEach(r => {
        const p = safeParse(String(r[DATA_COLS.indexOf('payload')]));
        const k = normAdm(p.admissionNo);
        if (k && !idx[k]) idx[k] = String(r[iId]);   // legacy duplicates: the first one found keeps the number
      });
    });
  }
  saveAdmissionIndex(orgId, idx);
  return idx;
}

function saveAdmissionIndex(orgId, idx) {
  try {
    const json = JSON.stringify(idx);
    if (json.length < 95000) CacheService.getScriptCache().put(admCacheKey(orgId), json, ADM_CACHE_SECONDS);
    else CacheService.getScriptCache().remove(admCacheKey(orgId));   // too big to cache: rebuilt each time
  } catch (e) { /* best-effort */ }
}

// Returns { error } if the number is taken by another student, else { number } (the normalised value to store).
function checkAdmissionNumber(orgId, sheet, payload, recordId, existingRow) {
  const number = normAdm(payload && payload.admissionNo);
  if (!number) return { error: 'Every student needs an admission number.' };
  // Saving a student whose number has not changed (a promotion, a class change, a photo) is always allowed, so schools that
  // already have duplicates from before this rule can still promote their students while they tidy the duplicates up.
  if (existingRow) {
    const was = normAdm(safeParse(existingRow.payload).admissionNo);
    if (was === number) return { number };
  }
  const idx = loadAdmissionIndex(orgId, sheet);
  const holder = idx[number];
  if (holder && holder !== recordId) {
    let who = 'another student';
    const hi = findRowIndexById(sheet, holder);
    if (hi !== -1) { const hp = safeParse(readRowAt(sheet, DATA_COLS, hi).payload); who = (hp.fullName || 'another student') + (hp.class ? ' (' + hp.class + (hp.arm ? ' ' + hp.arm : '') + ')' : ''); }
    return { error: 'Admission number ' + number + ' already belongs to ' + who + '. Every student must have their own admission number, and it never changes, even after promotion.' };
  }
  return { number };
}

// Keeps the cached index current after a successful student save.
function recordAdmissionNumber(orgId, sheet, recordId, number) {
  const idx = loadAdmissionIndex(orgId, sheet);
  Object.keys(idx).forEach(k => { if (idx[k] === recordId) delete idx[k]; });
  idx[number] = recordId;
  saveAdmissionIndex(orgId, idx);
}

// Run by hand (Apps Script editor) to list admission numbers shared by more than one student, per school.
function findDuplicateAdmissionNumbers() {
  const report = listTenantOrgIds().map(orgId => {
    const rows = readRows(getSheet(DATA_SHEET, orgId), DATA_COLS).filter(r => r.orgId === orgId && r.type === 'student');
    const seen = {}, dups = {};
    rows.forEach(r => { const p = safeParse(r.payload), k = normAdm(p.admissionNo); if (!k) return; (seen[k] = seen[k] || []).push(p.fullName + ' (' + (p.class || '') + ')'); });
    Object.keys(seen).forEach(k => { if (seen[k].length > 1) dups[k] = seen[k]; });
    return { orgId, duplicates: dups };
  });
  Logger.log(JSON.stringify(report, null, 2));
  return report;
}

/* ============================== ATTENDANCE (marking + summary) ============================== */
/* See the design note at the top of the "ATTENDANCE ARCHIVING & SUMMARIZATION" section in
   Tenancy.gs for the full reasoning. Short version: one `attendance` record per class per
   day (holding every student's status for that day in its payload — not one record per
   student per day), plus one `attendanceSummary` record per student per term that's
   incremented/decremented here by diffing against whatever was previously marked for that
   class+date. This is the ONLY path allowed to touch either type — see
   GENERIC_DATA_BLOCKED_TYPES above. */

function attendanceSummaryKey(studentId, term, session) { return `${studentId}|${term}|${session}`; }

function handleMarkAttendance(body, user) {
  if (!rolesToArray(user.roles).some(r => ATTENDANCE_ROLES.includes(r))) return { ok: false, error: 'You do not have permission to mark attendance' };
  const { classArm, date, term, session, statuses } = body; // statuses: { studentId: 'present'|'absent'|'late' }
  if (!classArm || !date || !term || !session || !statuses || typeof statuses !== 'object') {
    return { ok: false, error: 'Missing classArm, date, term, session, or statuses' };
  }
  const validStatuses = ['present', 'absent', 'late'];
  for (const s of Object.values(statuses)) {
    if (!validStatuses.includes(s)) return { ok: false, error: `Invalid status: ${s}` };
  }

  const sheet = getSheet(DATA_SHEET, user.orgId);
  const rows = readRows(sheet, DATA_COLS);
  const nowIso = new Date().toISOString();

  // Find any existing attendance record for this exact class+date, so we can diff against
  // it (re-marking or correcting a day must adjust counts, not double them).
  const existingIdx = rows.findIndex(r => r.type === 'attendance' && r.orgId === user.orgId &&
    safeParse(r.payload).classArm === classArm && safeParse(r.payload).date === date);
  const oldStatuses = existingIdx !== -1 ? (safeParse(rows[existingIdx].payload).statuses || {}) : {};

  // Load every summary row for this org once, so repeated lookups below don't re-scan.
  const summaryRows = readRows(sheet, DATA_COLS).map((r, idx) => ({ r, idx })).filter(({ r }) => r.type === 'attendanceSummary' && r.orgId === user.orgId);
  const summaryByKey = {};
  summaryRows.forEach(({ r, idx }) => { summaryByKey[attendanceSummaryKey(safeParse(r.payload).studentId, term, session)] = { row: r, idx }; });

  const countField = { present: 'presentCount', absent: 'absentCount', late: 'lateCount' };
  const affectedStudentIds = new Set([...Object.keys(oldStatuses), ...Object.keys(statuses)]);

  affectedStudentIds.forEach(studentId => {
    const was = oldStatuses[studentId] || null;
    const now = statuses[studentId] || null;
    if (was === now) return; // unchanged for this student — nothing to adjust

    const key = attendanceSummaryKey(studentId, term, session);
    let entry = summaryByKey[key];
    if (!entry) {
      const payload = { studentId, classArm, term, session, presentCount: 0, absentCount: 0, lateCount: 0, totalDays: 0, lastUpdated: nowIso };
      appendRow(sheet, DATA_COLS, {
        orgId: user.orgId, recordId: 'rec_' + Utilities.getUuid().slice(0, 10), ownerUserId: user.userId,
        type: 'attendanceSummary', payload: JSON.stringify(payload), createdAt: nowIso, updatedAt: nowIso
      });
      // Re-read to get this new row's real index (appendRow doesn't tell us the row number).
      const freshRows = readRows(sheet, DATA_COLS);
      const freshIdx = freshRows.length - 1;
      entry = { row: { payload: JSON.stringify(payload) }, idx: freshIdx };
      summaryByKey[key] = entry;
    }

    const summary = safeParse(entry.row.payload);
    if (was && countField[was]) summary[countField[was]] = Math.max(0, Number(summary[countField[was]] || 0) - 1);
    if (now && countField[now]) summary[countField[now]] = Number(summary[countField[now]] || 0) + 1;
    if (!was && now) summary.totalDays = Number(summary.totalDays || 0) + 1;
    if (was && !now) summary.totalDays = Math.max(0, Number(summary.totalDays || 0) - 1);
    summary.lastUpdated = nowIso;
    updateRow(sheet, DATA_COLS, entry.idx, { payload: JSON.stringify(summary), updatedAt: nowIso });
    entry.row.payload = JSON.stringify(summary); // keep our in-memory copy consistent in case of duplicate studentIds
  });

  // Finally, upsert the attendance (per-class-per-day) record itself.
  const attendancePayload = { classArm, date, term, session, statuses, markedBy: user.userId };
  if (existingIdx !== -1) {
    updateRow(sheet, DATA_COLS, existingIdx, { payload: JSON.stringify(attendancePayload), updatedAt: nowIso });
  } else {
    appendRow(sheet, DATA_COLS, {
      orgId: user.orgId, recordId: 'rec_' + Utilities.getUuid().slice(0, 10), ownerUserId: user.userId,
      type: 'attendance', payload: JSON.stringify(attendancePayload), createdAt: nowIso, updatedAt: nowIso
    });
  }

  return { ok: true };
}

// Read-only: fetch the single attendance record for one class+date, to prefill the Mark
// Attendance screen when reopening an already-marked day.
function handleGetAttendanceForClass(body, user) {
  if (!rolesToArray(user.roles).some(r => ATTENDANCE_ROLES.includes(r))) return { ok: false, error: 'You do not have permission to view attendance' };
  const { classArm, date } = body;
  const rows = readRows(getSheet(DATA_SHEET, user.orgId), DATA_COLS);
  const row = rows.find(r => r.type === 'attendance' && safeParse(r.payload).classArm === classArm && safeParse(r.payload).date === date);
  return { ok: true, record: row ? { recordId: row.recordId, payload: safeParse(row.payload) } : null };
}

// Read-only: every attendanceSummary row for a term/session (optionally one class), for
// Reports-style "X/Y days present" displays.
function handleGetAttendanceSummary(body, user) {
  if (!rolesToArray(user.roles).some(r => ATTENDANCE_ROLES.includes(r))) return { ok: false, error: 'You do not have permission to view attendance' };
  const { term, session, classArm } = body;
  const rows = readRows(getSheet(DATA_SHEET, user.orgId), DATA_COLS)
    .filter(r => r.type === 'attendanceSummary')
    .map(r => safeParse(r.payload))
    .filter(p => (!term || p.term === term) && (!session || p.session === session) && (!classArm || p.classArm === classArm));
  return { ok: true, summaries: rows };
}

/* ============================== ATTENDANCE EMAILS (weekly + end-of-term) ============================== */
/* Both of these are school-operational notifications, not correspondence from OKV Technology
   — they carry the SCHOOL's own name (from that org's Settings), sent under the default
   sender identity, with no platformEmailOptions wrapper. This matches how handleSendFeeListEmail
   already behaves, and follows the same "only OKV's own platform correspondence gets the
   OKV Technology Consults sender name" rule established elsewhere in this file.

   IMPORTANT PLATFORM-WIDE CONSTRAINT: every organization on this platform shares ONE Apps
   Script project, and therefore ONE MailApp sending quota (Gmail: ~100/day free accounts,
   ~1500/day Google Workspace). A school with hundreds of students sending a weekly digest
   to every parent can use a meaningful chunk of that shared quota in a single run. Both
   functions below check MailApp.getRemainingDailyQuota() before every send and stop
   cleanly — logging exactly who was skipped — rather than risk an exception mid-run or
   silently going over quota. Skipped sends are NOT retried automatically; if this becomes a
   frequent problem, the realistic fix is a Google Workspace account (much higher quota) or
   spacing these across more days. */

function mondayOf(d) {
  const day = d.getDay(); // 0=Sun..6=Sat
  const monday = new Date(d);
  monday.setDate(d.getDate() - ((day + 6) % 7));
  monday.setHours(0, 0, 0, 0);
  return monday;
}
function isoDate(d) { return `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}-${String(d.getDate()).padStart(2, '0')}`; }

// Groups students by the single email address that should receive attendance news for them
// — so a parent/guardian with more than one child at the school gets ONE combined email,
// not one per child. Checks linked Parent records first (a student can only be claimed by
// one parent's email this way), then falls back to each remaining student's own
// guardianEmail (siblings who share the same guardianEmail value are grouped together too).
function groupStudentsByParentEmail(students, parents) {
  const byEmail = {};
  const claimed = new Set();

  parents.forEach(p => {
    if (!p.email) return;
    (p.linkedStudentIds || []).forEach(sid => {
      if (claimed.has(sid)) return; // already claimed by an earlier parent record — don't double-list
      const st = students.find(s => s.recordId === sid);
      if (!st) return;
      (byEmail[p.email] = byEmail[p.email] || []).push(st);
      claimed.add(sid);
    });
  });

  students.forEach(st => {
    if (claimed.has(st.recordId) || !st.guardianEmail) return;
    (byEmail[st.guardianEmail] = byEmail[st.guardianEmail] || []).push(st);
    claimed.add(st.recordId);
  });

  return byEmail; // { email: [student, student, ...] }
}

// Run weekly (see setupWeeklyAttendanceEmailTrigger) — summarizes the week just finished
// (the most recently completed Monday–Friday) for every student, per org, only for orgs
// that have opted in via Settings.
function sendWeeklyAttendanceEmails() {
  const today = new Date();
  const thisMonday = mondayOf(today);
  const weekStart = new Date(thisMonday); weekStart.setDate(thisMonday.getDate() - 7); // previous Monday
  const weekEnd = new Date(thisMonday); weekEnd.setDate(thisMonday.getDate() - 3);     // previous Friday
  const weekStartStr = isoDate(weekStart), weekEndStr = isoDate(weekEnd);

  const results = [];
  let quotaExhausted = false;

  listTenantOrgIds().forEach(orgId => {
    if (quotaExhausted) { results.push({ orgId, skipped: 'stopped early — daily email quota reached' }); return; }
    const settings = readOrgSettingsDirect(orgId);
    if (settings.weeklyAttendanceEmailsEnabled !== true) return;

    try {
      const rows = readRows(getSheet(DATA_SHEET, orgId), DATA_COLS).filter(r => r.orgId === orgId);
      const students = rows.filter(r => r.type === 'student').map(r => ({ recordId: r.recordId, ...safeParse(r.payload) }));
      const parents = rows.filter(r => r.type === 'parent').map(r => safeParse(r.payload));
      const attendanceRows = rows.filter(r => r.type === 'attendance').map(r => safeParse(r.payload))
        .filter(p => p.date >= weekStartStr && p.date <= weekEndStr);

      let sent = 0, skipped = 0;
      const groups = groupStudentsByParentEmail(students, parents);

      Object.keys(groups).forEach(email => {
        if (MailApp.getRemainingDailyQuota() <= 0) { quotaExhausted = true; return; }
        const kids = groups[email];

        // Build one block per child, skipping any child with nothing marked this week.
        const blocks = kids.map(st => {
          const days = attendanceRows.filter(p => p.statuses && p.statuses[st.recordId])
            .map(p => ({ date: p.date, status: p.statuses[st.recordId] }))
            .sort((a, b) => a.date.localeCompare(b.date));
          if (!days.length) return null;
          const present = days.filter(d => d.status === 'present').length;
          const absent = days.filter(d => d.status === 'absent').length;
          const late = days.filter(d => d.status === 'late').length;
          const dayRows = days.map(d => `<tr><td>${new Date(d.date).toDateString()}</td><td style="text-transform:capitalize;">${escapeHtml(d.status)}</td></tr>`).join('');
          return `
            <h3 style="margin-bottom:4px;">${escapeHtml(st.fullName)}</h3>
            <p style="margin-top:0;"><strong>Present:</strong> ${present} &nbsp; <strong>Absent:</strong> ${absent} &nbsp; <strong>Late:</strong> ${late}</p>
            <table border="1" cellpadding="6" cellspacing="0" style="border-collapse:collapse;margin-bottom:16px;">
              <tr><th>Date</th><th>Status</th></tr>${dayRows}
            </table>`;
        }).filter(Boolean);

        if (!blocks.length) { skipped++; return; } // none of this parent's children were marked this week

        try {
          MailApp.sendEmail({
            to: email,
            subject: `${escapeHtml(settings.schoolName || 'Your School')} — Weekly Attendance${kids.length > 1 ? ' (' + kids.length + ' children)' : ''}`,
            htmlBody: `
              <p>Dear Parent/Guardian,</p>
              <p>Here is <strong>${escapeHtml(settings.schoolName || 'the school')}</strong>'s attendance summary for the week of ${weekStart.toDateString()} – ${weekEnd.toDateString()}:</p>
              ${blocks.join('')}
              <p style="margin-top:4px;">Questions about this week's attendance? Please reach out to the school directly.</p>
            `
          });
          sent++;
        } catch (err) { skipped++; }
      });

      results.push({ orgId, sent, skipped });
    } catch (err) {
      results.push({ orgId, error: String(err) });
    }
  });

  Logger.log(JSON.stringify({ week: `${weekStartStr} to ${weekEndStr}`, results }, null, 2));
  return results;
}

function setupWeeklyAttendanceEmailTrigger() {
  ScriptApp.getProjectTriggers().forEach(t => { if (t.getHandlerFunction() === 'sendWeeklyAttendanceEmails') ScriptApp.deleteTrigger(t); });
  ScriptApp.newTrigger('sendWeeklyAttendanceEmails').timeBased().onWeekDay(ScriptApp.WeekDay.SATURDAY).atHour(6).create();
  Logger.log('Weekly attendance email trigger installed (runs ~6am every Saturday).');
}

// Run daily (see setupTermSummaryEmailTrigger) — checks every org's optional Term End Date;
// once today is on or after that date, emails every parent a term summary exactly once
// (guarded by termSummarySentKey, keyed to that org's current term+session, so it can never
// double-send even if this trigger keeps running after the date has passed).
function sendTermSummaryEmailsIfDue() {
  const todayStr = isoDate(new Date());
  const results = [];
  let quotaExhausted = false;

  listTenantOrgIds().forEach(orgId => {
    if (quotaExhausted) { results.push({ orgId, skipped: 'stopped early — daily email quota reached' }); return; }
    const settings = readOrgSettingsDirect(orgId);
    if (!settings.termEndDate || todayStr < settings.termEndDate) return;
    const sentKey = `${settings.currentTerm || ''}|${settings.currentSession || ''}`;
    if (settings.termSummarySentKey === sentKey) return; // already sent for this exact term+session

    try {
      const rows = readRows(getSheet(DATA_SHEET, orgId), DATA_COLS).filter(r => r.orgId === orgId);
      const students = rows.filter(r => r.type === 'student').map(r => ({ recordId: r.recordId, ...safeParse(r.payload) }));
      const parents = rows.filter(r => r.type === 'parent').map(r => safeParse(r.payload));
      const summaries = rows.filter(r => r.type === 'attendanceSummary').map(r => safeParse(r.payload))
        .filter(p => p.term === settings.currentTerm && p.session === settings.currentSession);

      let sent = 0, skipped = 0;
      const groups = groupStudentsByParentEmail(students, parents);

      Object.keys(groups).forEach(email => {
        if (MailApp.getRemainingDailyQuota() <= 0) { quotaExhausted = true; return; }
        const kids = groups[email];

        const blocks = kids.map(st => {
          const summary = summaries.find(s => s.studentId === st.recordId);
          if (!summary || !summary.totalDays) return null;
          const pct = Math.round((summary.presentCount / summary.totalDays) * 100);
          return `
            <h3 style="margin-bottom:4px;">${escapeHtml(st.fullName)}</h3>
            <p style="margin-top:0;"><strong>Days Present:</strong> ${summary.presentCount} / ${summary.totalDays} (${pct}%)<br>
            <strong>Days Absent:</strong> ${summary.absentCount}<br>
            <strong>Days Late:</strong> ${summary.lateCount}</p>`;
        }).filter(Boolean);

        if (!blocks.length) { skipped++; return; } // none of this parent's children have a term summary yet

        try {
          MailApp.sendEmail({
            to: email,
            subject: `${escapeHtml(settings.schoolName || 'Your School')} — Term Attendance Summary${kids.length > 1 ? ' (' + kids.length + ' children)' : ''}`,
            htmlBody: `
              <p>Dear Parent/Guardian,</p>
              <p>Here is <strong>${escapeHtml(settings.schoolName || 'the school')}</strong>'s attendance summary for ${escapeHtml(settings.currentTerm || 'this term')}, ${escapeHtml(settings.currentSession || '')}:</p>
              ${blocks.join('')}
              <p style="margin-top:4px;">Questions about this term's attendance? Please reach out to the school directly.</p>
            `
          });
          sent++;
        } catch (err) { skipped++; }
      });

      if (!quotaExhausted) updateOrgSettingsDirect(orgId, { termSummarySentKey: sentKey });
      results.push({ orgId, sent, skipped });
    } catch (err) {
      results.push({ orgId, error: String(err) });
    }
  });

  Logger.log(JSON.stringify(results, null, 2));
  return results;
}

function setupTermSummaryEmailTrigger() {
  ScriptApp.getProjectTriggers().forEach(t => { if (t.getHandlerFunction() === 'sendTermSummaryEmailsIfDue') ScriptApp.deleteTrigger(t); });
  ScriptApp.newTrigger('sendTermSummaryEmailsIfDue').timeBased().everyDays(1).atHour(7).create();
  Logger.log('Daily term-summary check installed (runs ~7am, only emails on/after each org\'s Term End Date).');
}

/* ============================== PUBLIC RESULT CHECKER (no login required) ============================== */
/* Matches on orgId + admission number + surname only — this intentionally mirrors how
   most school portals gate result access, so no session/role check applies here. */

// Shared by every public (unauthenticated) student-facing endpoint.
/* ---------- Public portal identity: ADMISSION NUMBER + SURNAME ----------
   Assignments, CBT and fee payment all verify a student with their admission number and surname, typed in
   capital letters on the page. The comparison ignores case and spacing (so a phone that fails to capitalise
   still works), and the surname must match WHOLE words of the stored name: "OKON" no longer matches
   "OKONKWO". A multi-word or hyphenated surname works as long as its words appear together, in order. */
function nameWords(s) {
  return String(s || '').trim().toLowerCase().replace(/\s+/g, ' ').split(' ').filter(Boolean);
}
function surnameMatches(storedFullName, typedSurname) {
  const stored = nameWords(storedFullName), typed = nameWords(typedSurname);
  if (!typed.length) return false;
  for (let i = 0; i + typed.length <= stored.length; i++) {
    if (typed.every((w, k) => stored[i + k] === w)) return true;
  }
  return false;
}
function findPublicStudentBySurname(rows, admissionNo, surname) {
  const want = String(admissionNo || '').trim().toLowerCase();
  if (!want) return null;
  const studentRow = rows.find(r => {
    if (r.type !== 'student') return false;
    const p = safeParse(r.payload);
    if (p.active === false) return false;
    return String(p.admissionNo || '').trim().toLowerCase() === want && surnameMatches(p.fullName, surname);
  });
  return studentRow ? { studentRow, student: safeParse(studentRow.payload) } : null;
}
// Older names kept so any remaining caller keeps working; both now use the strict surname rule.
function findPublicStudent(rows, admissionNo, surname) { return findPublicStudentBySurname(rows, admissionNo, surname); }
function findPublicStudentByFullName(rows, admissionNo, surname) { return findPublicStudentBySurname(rows, admissionNo, surname); }

const DOMAIN_LIST = ['Punctuality','Attendance','Self-Control','Neatness','Responsibility','Diligence','Attentiveness','Legibility','Accuracy','Sports & Games'];

// Builds the full public-facing result payload for one student/term — shared by the
// admission+surname flow and the passcode flow so both stay in sync automatically.
// Name of the form (class) teacher for a student's class and arm, so the public sheet can carry the class teacher's name.
function lookupClassTeacherName(orgId, rows, student) {
  try {
    const ct = rows.find(r => r.type === 'classTeacher' && (function(p){ return p.class === student.class && (p.arm || '') === (student.arm || ''); })(safeParse(r.payload)));
    if (!ct) return '';
    const uid = safeParse(ct.payload).teacherUserId;
    const users = readRows(getSheet(USERS_SHEET, orgId), USER_COLS);
    const u = users.find(x => x.userId === uid);
    return u ? u.fullName : '';
  } catch (e) { return ''; }
}

function buildPublicResultPayload(rows, studentRow, student, term, session, reportType) {
  reportType = reportType || 'term';
  const isYearly = reportType === 'yearly';
  const TERM_NAMES = ['First Term', 'Second Term', 'Third Term'];

  const feeRow = rows.find(r => {
    if (r.type !== 'feeRecord') return false;
    const p = safeParse(r.payload);
    return p.studentId === studentRow.recordId && (!term || p.term === term) && (!session || p.session === session);
  });
  const fee = feeRow ? safeParse(feeRow.payload) : null;
  const amountDue = fee ? Number(fee.amountDue || 0) : 0;
  const amountPaid = fee ? Number(fee.amountPaid || 0) : 0;
  // For a yearly cumulative report, clearance is checked against Third Term (the term that closes the session).
  const clearanceCheckOk = isYearly ? true : true; // clearance logic below is unchanged either way
  const cleared = !!fee && amountPaid >= amountDue;

  if (!cleared) {
    return {
      ok: true, cleared: false,
      studentName: student.fullName,
      owing: fee ? Math.max(0, amountDue - amountPaid) : null,
      reason: fee ? 'Outstanding fees for this term.' : 'No fee/clearance record found for this term yet — please contact the school office.'
    };
  }

  const settingsRow = rows.find(r => r.type === 'settings');
  const settings = settingsRow ? safeParse(settingsRow.payload) : {};

  const noInClass = rows.filter(r => r.type === 'student' &&
    safeParse(r.payload).class === student.class && (safeParse(r.payload).arm||'') === (student.arm||'')).length;

  // School bill: every Fee Type's standard amount, minus this student's confirmed payments for the term.
  const feeTypeRows = rows.filter(r => r.type === 'feeType').map(r => safeParse(r.payload));
  const confirmedPaid = rows.filter(r => {
    if (r.type !== 'feePayment') return false;
    const p = safeParse(r.payload);
    return p.studentId === studentRow.recordId && (!term || p.term === term) && (!session || p.session === session) &&
      (p.status === 'confirmed-full' || p.status === 'confirmed-partial');
  }).reduce((sum, r) => sum + Number(safeParse(r.payload).confirmedAmount || 0), 0);
  const billTotal = feeTypeRows.reduce((sum, f) => sum + Number(f.amount || 0), 0);
  const outstandingBill = Math.max(0, billTotal - confirmedPaid);

  const base = {
    ok: true, cleared: true, reportType,
    student: { fullName: student.fullName, admissionNo: student.admissionNo, class: student.class, arm: student.arm, gender: student.gender || '', dob: student.dob || '', photo: student.photo || '' },
    session, noInClass,
    section: (settings.classSections || {})[student.class] || '',
    schoolBill: { items: feeTypeRows.map(f => ({ name: f.name, amount: Number(f.amount||0) })), outstanding: outstandingBill, total: billTotal },
    schoolName: settings.schoolName || '', schoolLogo: settings.schoolLogo || '', schoolAddress: settings.schoolAddress || '',
    schoolMotto: settings.schoolMotto || '', schoolPhone: settings.schoolPhone || '', schoolEmail: settings.schoolEmail || '',
    principalName: settings.principalName || '', principalSignature: settings.principalSignature || '',
    classTeacherName: lookupClassTeacherName(student.orgId || studentRow.orgId, rows, student),
    ...publicBrandFields(settings)
  };

  if (!isYearly) {
    const scoreRows = rows.filter(r => {
      if (r.type !== 'score') return false;
      const p = safeParse(r.payload);
      return p.studentId === studentRow.recordId && (!term || p.term === term) && (!session || p.session === session);
    }).map(r => safeParse(r.payload));

    const termInfoRow = rows.find(r => {
      if (r.type !== 'studentTermInfo') return false;
      const p = safeParse(r.payload);
      return p.studentId === studentRow.recordId && (!term || p.term === term) && (!session || p.session === session);
    });
    const termInfo = termInfoRow ? safeParse(termInfoRow.payload) : {};

    const classmateTotals = rows.filter(r => {
      if (r.type !== 'score') return false;
      const p = safeParse(r.payload);
      return p.class === student.class && (p.arm||'') === (student.arm||'') && (!term || p.term === term) && (!session || p.session === session);
    }).reduce((map, r) => {
      const p = safeParse(r.payload);
      map[p.studentId] = (map[p.studentId] || 0) + Number(p.total || 0);
      return map;
    }, {});
    const sortedTotals = Object.entries(classmateTotals).sort((a,b) => b[1]-a[1]);
    const position = sortedTotals.findIndex(([sid]) => sid === studentRow.recordId) + 1;

    const termInfoKey = `${term}|${session}`;
    const termMeta = (settings.termInfo || {})[termInfoKey] || {};
    const overallTotal = scoreRows.reduce((s, r) => s + Number(r.total || 0), 0);
    const subjectCount = scoreRows.length || 1;
    const avg = overallTotal / subjectCount;

    return {
      ...base, term, position,
      scores: scoreRows,
      overallTotal, average: Math.round(avg * 100) / 100, percentage: Math.round(avg),
      attendance: { timesPresent: termInfo.timesPresent || 0, timesAbsent: termInfo.timesAbsent || 0, timesSchoolOpened: termMeta.timesSchoolOpened || 0 },
      domainRatings: termInfo.domainRatings || {},
      termMeta: { closingDate: termMeta.closingDate || '', resumptionDate: termMeta.resumptionDate || '' }
    };
  }

  // ===== YEARLY CUMULATIVE: aggregate First/Second/Third Term scores for this session =====
  const allYearScores = rows.filter(r => {
    if (r.type !== 'score') return false;
    const p = safeParse(r.payload);
    return p.studentId === studentRow.recordId && p.session === session && TERM_NAMES.includes(p.term);
  }).map(r => safeParse(r.payload));

  const bySubject = {};
  allYearScores.forEach(sc => {
    if (!bySubject[sc.subject]) bySubject[sc.subject] = { name: sc.subject, term1Total: 0, term2Total: 0, term3Total: 0 };
    if (sc.term === 'First Term') bySubject[sc.subject].term1Total = Number(sc.total || 0);
    if (sc.term === 'Second Term') bySubject[sc.subject].term2Total = Number(sc.total || 0);
    if (sc.term === 'Third Term') bySubject[sc.subject].term3Total = Number(sc.total || 0);
  });
  const yearlySubjects = Object.values(bySubject).map(sub => {
    const total300 = sub.term1Total + sub.term2Total + sub.term3Total;
    const avg = total300 / 3;
    return { ...sub, total300, average: Math.round(avg * 100) / 100, remark: window_smsResults_overallComment(avg) };
  });

  const overallTotal = yearlySubjects.reduce((s, r) => s + r.total300, 0);
  const subjectCount = yearlySubjects.length || 1;
  const avgAcrossSubjects = overallTotal / subjectCount;

  // Position for yearly: rank classmates by their own cumulative (3-term) total.
  const allClassScoresYear = rows.filter(r => {
    if (r.type !== 'score') return false;
    const p = safeParse(r.payload);
    return p.class === student.class && (p.arm||'') === (student.arm||'') && p.session === session && TERM_NAMES.includes(p.term);
  }).reduce((map, r) => {
    const p = safeParse(r.payload);
    map[p.studentId] = (map[p.studentId] || 0) + Number(p.total || 0);
    return map;
  }, {});
  const sortedYear = Object.entries(allClassScoresYear).sort((a,b) => b[1]-a[1]);
  const positionYear = sortedYear.findIndex(([sid]) => sid === studentRow.recordId) + 1;

  // Attendance/domain ratings for yearly: use Third Term's entry (the closing term), if present.
  const thirdTermInfoRow = rows.find(r => {
    if (r.type !== 'studentTermInfo') return false;
    const p = safeParse(r.payload);
    return p.studentId === studentRow.recordId && p.term === 'Third Term' && p.session === session;
  });
  const thirdTermInfo = thirdTermInfoRow ? safeParse(thirdTermInfoRow.payload) : {};
  const thirdTermMeta = (settings.termInfo || {})[`Third Term|${session}`] || {};

  return {
    ...base, term: 'Yearly Cumulative', position: positionYear,
    subjects: yearlySubjects,
    overallTotal, average: Math.round(avgAcrossSubjects * 100) / 100, percentage: Math.round(avgAcrossSubjects),
    attendance: { timesPresent: thirdTermInfo.timesPresent || 0, timesAbsent: thirdTermInfo.timesAbsent || 0, timesSchoolOpened: thirdTermMeta.timesSchoolOpened || 0 },
    domainRatings: thirdTermInfo.domainRatings || {},
    termMeta: { closingDate: thirdTermMeta.closingDate || '', resumptionDate: thirdTermMeta.resumptionDate || '' }
  };
}
// results-lib.js isn't loaded server-side — mirror its overallComment() logic here for yearly remarks.
function window_smsResults_overallComment(avg) {
  if (avg >= 70) return 'Excellent';
  if (avg >= 60) return 'Very Good';
  if (avg >= 50) return 'Good';
  if (avg >= 45) return 'Fair';
  if (avg >= 40) return 'Poor';
  return 'Fail';
}

// Retired: results are checked with the school-issued passcode only (see handlePublicCheckResultByPasscode). Kept as a
// stub so nothing that still references it breaks, and so the old admission-number route can never open a result again.
function handlePublicCheckResult(body) {
  return { ok: false, error: 'Results are now checked with the passcode your school gave you. Select the session, term and class, then type the passcode.' };
}

const PASSCODE_LENGTH = 8;            // with no surname to check, the passcode is the only secret, so it is long
const PASSCODE_MAX_FAILS = 40;        // wrong guesses allowed per class+term+session ...
const PASSCODE_LOCK_SECONDS = 900;    // ... within this window (15 minutes) before further tries are paused

// An unguessable-enough numeric code that is not already used for this term and session.
function newUniquePasscode(used) {
  for (let tries = 0; tries < 200; tries++) {
    const lo = Math.pow(10, PASSCODE_LENGTH - 1);
    const code = String(lo + Math.floor(Math.random() * (9 * lo)));
    if (!used[code]) { used[code] = true; return code; }
  }
  throw new Error('Could not create a unique passcode. Please try again.');
}

function handleGenerateResultPasscodes(body, user) {
  const { classFilter, arm, term, session } = body;
  if (!classFilter || !term || !session) return { ok: false, error: 'Select a class, term, and session.' };
  return withDataLock(() => generatePasscodesLocked(body, user), 60000);
}

function generatePasscodesLocked(body, user) {
  const { classFilter, arm, term, session } = body;
  const regenerate = body.regenerate === true;

  const dataSheet = getSheet(DATA_SHEET, user.orgId);
  const rows = readRows(dataSheet, DATA_COLS).filter(r => r.orgId === user.orgId);
  const students = rows.filter(r => {
    if (r.type !== 'student') return false;
    const p = safeParse(r.payload);
    return p.class === classFilter && (p.arm||'') === (arm||'') && p.active !== false;
  });
  if (!students.length) return { ok: false, error: 'No students found in that class/arm.' };

  // Every code already issued for this term + session (any class), so no two students ever share one.
  const existingPasscodes = withArchivedResultRows(user.orgId, rows).filter(r => r.type === 'resultPasscode');
  const used = {};
  existingPasscodes.forEach(r => { const p = safeParse(r.payload); if (p.term === term && p.session === session) used[String(p.passcode)] = true; });
  const nowIso = new Date().toISOString();
  const results = [];

  students.forEach(sRow => {
    const student = safeParse(sRow.payload);
    const pcRow = existingPasscodes.find(r => {
      const p = safeParse(r.payload);
      return p.studentId === sRow.recordId && p.term === term && p.session === session;
    });
    let passcode;
    if (pcRow && !regenerate) {
      passcode = safeParse(pcRow.payload).passcode;
    } else {
      passcode = newUniquePasscode(used);
      const payload = JSON.stringify({ studentId: sRow.recordId, class: classFilter, arm: arm||'', term, session, passcode, printedAt: nowIso });
      const liveIdx = pcRow ? findRowIndexById(dataSheet, pcRow.recordId) : -1;
      if (pcRow && liveIdx !== -1) {
        updateRow(dataSheet, DATA_COLS, liveIdx, { payload, updatedAt: nowIso });
      } else {
        appendRow(dataSheet, DATA_COLS, {
          orgId: user.orgId, recordId: 'rec_' + Utilities.getUuid().slice(0, 10), ownerUserId: user.userId, type: 'resultPasscode',
          payload, createdAt: nowIso, updatedAt: nowIso
        });
      }
    }
    results.push({ fullName: student.fullName, admissionNo: student.admissionNo, passcode });
  });

  return { ok: true, students: results, regenerated: regenerate, length: PASSCODE_LENGTH };
}

// PASSCODE-ONLY result check: the student selects Session, Term and Class and types the passcode the school
// gave them. No admission number or surname is asked for. Wrong guesses are counted per class+term+session;
// after PASSCODE_MAX_FAILS wrong tries the class is paused for PASSCODE_LOCK_SECONDS, so the code cannot be brute-forced.
function handlePublicCheckResultByPasscode(body) {
  const { orgId, classFilter, arm, term, session } = body;
  const passcode = String(body.passcode || '').replace(/\s+/g, '');
  if (!orgId || !classFilter || !term || !session || !passcode) {
    return { ok: false, error: 'Please select the session, term and class, and type your passcode.' };
  }

  const cache = CacheService.getScriptCache();
  const failKey = ('pcfail|' + orgId + '|' + classFilter + '|' + (arm || '') + '|' + term + '|' + session).slice(0, 240);
  const fails = Number(cache.get(failKey) || 0);
  if (fails >= PASSCODE_MAX_FAILS) {
    return { ok: false, error: 'Too many incorrect passcodes were tried for this class. Please wait about 15 minutes and try again, or ask the school office.' };
  }

  const dataSheet = getSheet(DATA_SHEET, orgId);
  const rows = withArchivedResultRows(orgId, readRows(dataSheet, DATA_COLS).filter(r => r.orgId === orgId));

  const pcRow = rows.find(r => {
    if (r.type !== 'resultPasscode') return false;
    const p = safeParse(r.payload);
    return p.class === classFilter && (p.arm||'') === (arm||'') && p.term === term && p.session === session &&
      String(p.passcode) === passcode;
  });
  if (!pcRow) {
    cache.put(failKey, String(fails + 1), PASSCODE_LOCK_SECONDS);
    return { ok: false, error: 'That passcode is not correct for the class, term and session you selected. Check them and try again, or ask the school office.' };
  }

  const pc = safeParse(pcRow.payload);
  const studentRow = rows.find(r => r.type === 'student' && r.recordId === pc.studentId);
  if (!studentRow) return { ok: false, error: 'Student record not found — please contact the school office.' };
  const student = safeParse(studentRow.payload);

  const reportType = term === 'Yearly Cumulative' ? 'yearly' : 'term';
  return buildPublicResultPayload(rows, studentRow, student, term, session, reportType);
}

/* ============================== PUBLIC CBT TEST-TAKING (no login required) ============================== */
/* Same admission-number + surname gate as the result checker. Correct answers are NEVER
   sent to the client — findCbtTests/startCbt strip them out, and scoring happens only in
   submitCbt, server-side, against the real question data. */

function sanitizeQuestionsForClient(questions) {
  return (questions || []).map(q => ({ text: q.text, options: q.options }));
}

function handlePublicFindCbtTests(body) {
  const { orgId, admissionNo } = body;
  const surname = body.surname || body.fullName;
  if (!orgId || !admissionNo || !surname) return { ok: false, error: 'Enter your admission number and surname.' };

  const dataSheet = getSheet(DATA_SHEET, orgId);
  const rows = readRows(dataSheet, DATA_COLS).filter(r => r.orgId === orgId);

  const found = findPublicStudentBySurname(rows, admissionNo, surname);
  if (!found) return { ok: false, error: 'No matching student found. Check your admission number and surname (in CAPITAL LETTERS) and try again.' };
  const { studentRow, student } = found;

  const now = Date.now();
  const submissions = rows.filter(r => r.type === 'cbtSubmission').map(r => ({ recordId: r.recordId, payload: safeParse(r.payload) }));

  const tests = rows.filter(r => {
    if (r.type !== 'cbtTest') return false;
    const p = safeParse(r.payload);
    if (p.class !== student.class || (p.arm || '') !== (student.arm || '')) return false;
    if (student.schoolId && p.schoolId && student.schoolId !== p.schoolId) return false;
    const start = p.startTime ? new Date(p.startTime).getTime() : null;
    const stop = p.stopTime ? new Date(p.stopTime).getTime() : null;
    if (!start || !stop || now < start || now > stop) return false; // must be Live right now
    const already = submissions.some(s => s.payload.testId === r.recordId && s.payload.studentId === studentRow.recordId);
    return !already;
  }).map(r => {
    const p = safeParse(r.payload);
    return { testId: r.recordId, topic: p.topic, subject: p.subject, class: p.class, arm: p.arm, allocatedMinutes: p.allocatedMinutes, questionCount: (p.questions||[]).length };
  });

  return { ok: true, studentName: student.fullName, tests };
}

function handlePublicStartCbt(body) {
  const { orgId, admissionNo, testId } = body;
  const surname = body.surname || body.fullName;
  if (!orgId || !admissionNo || !surname || !testId) return { ok: false, error: 'Missing required fields' };

  const dataSheet = getSheet(DATA_SHEET, orgId);
  const rows = readRows(dataSheet, DATA_COLS).filter(r => r.orgId === orgId);

  const found = findPublicStudentBySurname(rows, admissionNo, surname);
  if (!found) return { ok: false, error: 'No matching student found.' };
  const { studentRow, student } = found;

  const testRow = rows.find(r => r.type === 'cbtTest' && r.recordId === testId);
  if (!testRow) return { ok: false, error: 'This test is no longer available.' };
  const test = safeParse(testRow.payload);
  if (test.class !== student.class || (test.arm || '') !== (student.arm || '')) {
    return { ok: false, error: 'This test is not available for your class.' };
  }

  const now = Date.now();
  const start = test.startTime ? new Date(test.startTime).getTime() : null;
  const stop = test.stopTime ? new Date(test.stopTime).getTime() : null;
  if (!start || !stop || now < start || now > stop) {
    return { ok: false, error: 'This test is not currently open.' };
  }

  const existing = rows.find(r => r.type === 'cbtSubmission' &&
    safeParse(r.payload).testId === testId && safeParse(r.payload).studentId === studentRow.recordId);
  if (existing) {
    const ep = safeParse(existing.payload);
    if (ep.status === 'submitted') return { ok: false, error: 'You have already submitted this test.' };
    return { ok: false, error: 'A session for this test is already in progress. Close other tabs/windows and reload there instead.' };
  }

  const nowIso = new Date(now).toISOString();
  const dataSheetForWrite = getSheet(DATA_SHEET, orgId);
  const submissionId = 'rec_' + Utilities.getUuid().slice(0, 10);
  appendRow(dataSheetForWrite, DATA_COLS, {
    orgId, recordId: submissionId, ownerUserId: '', type: 'cbtSubmission',
    payload: JSON.stringify({ testId, studentId: studentRow.recordId, status: 'started', startedAt: nowIso, answers: [], score: null, totalQuestions: (test.questions||[]).length }),
    createdAt: nowIso, updatedAt: nowIso
  });

  return {
    ok: true, submissionId, startedAt: nowIso,
    topic: test.topic, subject: test.subject, instructions: test.instructions,
    allocatedMinutes: test.allocatedMinutes, stopTime: test.stopTime,
    studentName: student.fullName,
    questions: sanitizeQuestionsForClient(test.questions)
  };
}

function handlePublicSubmitCbt(body) {
  const { orgId, submissionId, answers, autoReason } = body;
  if (!orgId || !submissionId) return { ok: false, error: 'Missing required fields' };

  const dataSheet = getSheet(DATA_SHEET, orgId);
  const rows = readRows(dataSheet, DATA_COLS).filter(r => r.orgId === orgId);
  const rowsFull = readRows(dataSheet, DATA_COLS); // for index lookup below

  const subIdx = rowsFull.findIndex(r => r.orgId === orgId && r.recordId === submissionId && r.type === 'cbtSubmission');
  if (subIdx === -1) return { ok: false, error: 'Submission not found.' };
  const sub = safeParse(rowsFull[subIdx].payload);
  if (sub.status === 'submitted') return { ok: true, alreadySubmitted: true }; // idempotent — safe if beacon + explicit submit both fire

  const testRow = rows.find(r => r.type === 'cbtTest' && r.recordId === sub.testId);
  if (!testRow) return { ok: false, error: 'The original test could not be found.' };
  const test = safeParse(testRow.payload);

  const givenAnswers = Array.isArray(answers) ? answers : [];
  let score = 0;
  (test.questions || []).forEach((q, i) => {
    if (givenAnswers[i] !== undefined && Number(givenAnswers[i]) === Number(q.correctIndex)) score++;
  });

  const nowIso = new Date().toISOString();
  updateRow(dataSheet, DATA_COLS, subIdx, {
    payload: JSON.stringify({
      ...sub, status: 'submitted', answers: givenAnswers, score,
      totalQuestions: (test.questions||[]).length, submittedAt: nowIso,
      autoReason: autoReason || 'manual'
    }),
    updatedAt: nowIso
  });

  return { ok: true, score, total: (test.questions||[]).length };
}

// Admin-tier, or the teacher who owns the test, can clear a stuck/incomplete submission
// (or a submitted one, to allow a retake) so the student gets a fresh attempt.
function handleResetCbtSubmission(body, user) {
  const { recordId } = body;
  if (!recordId) return { ok: false, error: 'Missing recordId' };
  const dataSheet = getSheet(DATA_SHEET, user.orgId);
  const rows = readRows(dataSheet, DATA_COLS);
  const idx = rows.findIndex(r => r.recordId === recordId && r.orgId === user.orgId && r.type === 'cbtSubmission');
  if (idx === -1) return { ok: false, error: 'Submission not found' };

  const sub = safeParse(rows[idx].payload);
  const testRow = rows.find(r => r.recordId === sub.testId && r.type === 'cbtTest');
  const test = testRow ? safeParse(testRow.payload) : null;
  const allowed = isAdminTier(user.roles) ||
    (rolesToArray(user.roles).includes('Teacher') && test && test.teacherUserId === user.userId);
  if (!allowed) return { ok: false, error: 'Not permitted to reset this submission' };

  dataSheet.deleteRow(idx + 2);
  return { ok: true };
}

/* ============================== PUBLIC ASSIGNMENTS (no login required) ============================== */
/* Separate from CBT tests on purpose — an Assignment is untimed coursework a student reads/
   responds to, not a locked-down, auto-graded, timed exam. Same Admission Number + Full Name
   identification as CBT, per the request. */

function handlePublicFindAssignments(body) {
  const { orgId, admissionNo } = body;
  const surname = body.surname || body.fullName;
  if (!orgId || !admissionNo || !surname) return { ok: false, error: 'Enter your admission number and surname.' };

  const dataSheet = getSheet(DATA_SHEET, orgId);
  const rows = readRows(dataSheet, DATA_COLS).filter(r => r.orgId === orgId);

  const found = findPublicStudentBySurname(rows, admissionNo, surname);
  if (!found) return { ok: false, error: 'No matching student found. Check your admission number and surname (in CAPITAL LETTERS) and try again.' };
  const { studentRow, student } = found;

  const submissions = rows.filter(r => r.type === 'assignmentSubmission').map(r => safeParse(r.payload));

  const assignments = rows.filter(r => {
    if (r.type !== 'assignment') return false;
    const p = safeParse(r.payload);
    if (p.class !== student.class || (p.arm || '') !== (student.arm || '')) return false;
    if (student.schoolId && p.schoolId && student.schoolId !== p.schoolId) return false;
    const already = submissions.some(s => s.assignmentId === r.recordId && s.studentId === studentRow.recordId);
    return !already;
  }).map(r => {
    const p = safeParse(r.payload);
    return {
      assignmentId: r.recordId, title: p.title, subject: p.subject, instructions: p.instructions,
      attachmentUrl: p.attachmentUrl || '', dueDate: p.dueDate || '', class: p.class, arm: p.arm
    };
  });
  assignments.sort((a, b) => (a.dueDate || '9999').localeCompare(b.dueDate || '9999'));

  return { ok: true, studentName: student.fullName, assignments };
}

function handlePublicSubmitAssignment(body) {
  const { orgId, admissionNo, assignmentId, responseText } = body;
  const surname = body.surname || body.fullName;
  if (!orgId || !admissionNo || !surname || !assignmentId) return { ok: false, error: 'Missing required fields' };

  const dataSheet = getSheet(DATA_SHEET, orgId);
  const rows = readRows(dataSheet, DATA_COLS).filter(r => r.orgId === orgId);

  const found = findPublicStudentBySurname(rows, admissionNo, surname);
  if (!found) return { ok: false, error: 'No matching student found.' };
  const { studentRow, student } = found;

  const assignmentRow = rows.find(r => r.type === 'assignment' && r.recordId === assignmentId);
  if (!assignmentRow) return { ok: false, error: 'This assignment is no longer available.' };
  const assignment = safeParse(assignmentRow.payload);
  if (assignment.class !== student.class || (assignment.arm || '') !== (student.arm || '')) {
    return { ok: false, error: 'This assignment is not available for your class.' };
  }

  const already = rows.find(r => r.type === 'assignmentSubmission' &&
    safeParse(r.payload).assignmentId === assignmentId && safeParse(r.payload).studentId === studentRow.recordId);
  if (already) return { ok: false, error: 'You have already submitted this assignment.' };

  const recordId = 'rec_' + Utilities.getUuid().slice(0, 10);
  const nowIso = new Date().toISOString();
  appendRow(dataSheet, DATA_COLS, {
    orgId, recordId, ownerUserId: '', type: 'assignmentSubmission',
    payload: JSON.stringify({
      assignmentId, studentId: studentRow.recordId, studentName: student.fullName,
      responseText: responseText || '', submittedAt: nowIso
    }),
    createdAt: nowIso, updatedAt: nowIso
  });
  return { ok: true };
}


/* Unlike the result checker and CBT entry, this form doesn't require an exact admission-number
   + surname match to a Student record — a family may be paying before formal enrollment is
   complete, or the name they type may not match exactly. We link to a Student record by
   admission number when we can (so Bursar review + the class/arm shown are informed by it),
   but we never block the submission on it failing to match. */

function handlePublicGetOrgInfo(body) {
  const { orgId } = body;
  if (!orgId) return { ok: false, error: 'Missing orgId' };
  const dataSheet = getSheet(DATA_SHEET, orgId);
  const rows = readRows(dataSheet, DATA_COLS).filter(r => r.orgId === orgId);
  const settingsRow = rows.find(r => r.type === 'settings');
  const settings = settingsRow ? safeParse(settingsRow.payload) : {};

  const feeTypeRows = rows.filter(r => r.type === 'feeType').map(r => ({ feeTypeId: r.recordId, ...safeParse(r.payload) }));
  const configuredNames = feeTypeRows.map(f => f.name.toLowerCase());
  const commonFeeNames = COMMON_FEE_PRESETS.filter(name => !configuredNames.includes(name.toLowerCase()));

  // Sessions a student can pick on the result page: the current one plus any session that has passcodes issued.
  const sessionSet = {};
  if (settings.currentSession) sessionSet[settings.currentSession] = true;
  withArchivedResultRows(orgId, rows).forEach(r => { if (r.type === 'resultPasscode') { const s = safeParse(r.payload).session; if (s) sessionSet[s] = true; } });
  const sessions = Object.keys(sessionSet).sort().reverse();

  return {
    ok: true, sessions, currentTerm: settings.currentTerm || '', currentSession: settings.currentSession || '',
    schoolName: settings.schoolName || '', schoolLogo: settings.schoolLogo || '',
    schoolAddress: settings.schoolAddress || '', schoolPhone: settings.schoolPhone || '',
    schoolEmail: settings.schoolEmail || '', schoolMotto: settings.schoolMotto || '',
    ...publicBrandFields(settings),
    classes: settings.classes || [],
    classArms: settings.classArms || {},
    subjects: settings.subjects || [],
    feeTypes: feeTypeRows,
    commonFeeNames,
    bankAccountNumber: settings.bankAccountNumber || '',
    bankName: settings.bankName || '',
    bankAccountName: settings.bankAccountName || ''
  };
}

function handlePublicListFeeTypes(body) {
  const { orgId } = body;
  if (!orgId) return { ok: false, error: 'Missing orgId' };
  const dataSheet = getSheet(DATA_SHEET, orgId);
  const rows = readRows(dataSheet, DATA_COLS).filter(r => r.orgId === orgId && r.type === 'feeType');
  const settingsRow = readRows(dataSheet, DATA_COLS).find(r => r.orgId === orgId && r.type === 'settings');
  const settings = settingsRow ? safeParse(settingsRow.payload) : {};
  return {
    ok: true,
    feeTypes: rows.map(r => ({ feeTypeId: r.recordId, ...safeParse(r.payload) })),
    classes: settings.classes || [],
    classArms: settings.classArms || {}
  };
}

// Lets a parent see the full fee breakdown and their running balance BEFORE submitting a
// payment — "automatically see the amount they are paying and the list of fees". Uses the
// same lenient admission-number-only match as the payment submission itself (this page
// doesn't require an exact surname match, unlike the result checker/CBT entry).
function handlePublicGetFeeStatus(body) {
  const { orgId, admissionNo, term, session } = body;
  const surname = body.surname || body.fullName;
  if (!orgId || !admissionNo || !surname) return { ok: false, error: 'Enter your admission number and surname (in CAPITAL LETTERS).' };

  const dataSheet = getSheet(DATA_SHEET, orgId);
  const rows = readRows(dataSheet, DATA_COLS).filter(r => r.orgId === orgId);
  const found = findPublicStudentBySurname(rows, admissionNo, surname);
  if (!found) return { ok: false, error: 'No matching student found. Check your admission number and surname (in CAPITAL LETTERS) and try again.' };

  const feeTypes = rows.filter(r => r.type === 'feeType').map(r => ({ feeTypeId: r.recordId, ...safeParse(r.payload) }));
  const totalDue = feeTypes.reduce((s, f) => s + Number(f.amount || 0), 0);
  let amountPaid = 0;
  if (term && session) {
    const feeRecRow = rows.find(r => r.type === 'feeRecord' &&
      safeParse(r.payload).studentId === found.studentRow.recordId &&
      safeParse(r.payload).term === term && safeParse(r.payload).session === session);
    if (feeRecRow) amountPaid = Number(safeParse(feeRecRow.payload).amountPaid || 0);
  }
  return {
    ok: true, matched: true, studentName: found.student.fullName, className: found.student.class || '', arm: found.student.arm || '',
    feeTypes, totalDue, amountPaid, balance: Math.max(0, totalDue - amountPaid)
  };
}

function handlePublicSubmitFeePayment(body) {
  const { orgId, admissionNo, term, session, feeTypeId, customFeeName, amountPaid, receiptDataUrl, payerEmail } = body;
  const surname = body.surname || body.fullName;
  if (!orgId || !admissionNo || !surname || !term || !session || (!feeTypeId && !customFeeName) || !amountPaid || !payerEmail) {
    return { ok: false, error: 'Please fill in every field, including a valid email for your payment status.' };
  }

  const dataSheet = getSheet(DATA_SHEET, orgId);
  const rows = readRows(dataSheet, DATA_COLS).filter(r => r.orgId === orgId);

  // The payer must be identified by admission number + surname, exactly like assignments and CBT. The name, class and arm
  // on the payment come from the school's own student record, never from what was typed.
  const found = findPublicStudentBySurname(rows, admissionNo, surname);
  if (!found) return { ok: false, error: 'No matching student found. Check your admission number and surname (in CAPITAL LETTERS) and try again.' };
  const fullName = found.student.fullName;
  const className = found.student.class || '';
  const arm = found.student.arm || '';

  // Either a configured fee type (feeTypeId) or a common/"Others" fee typed in freehand
  // (customFeeName) — the fee dropdown always offers both, so the payment form is never
  // blocked just because the school hasn't set up every fee as a formal Fee Type.
  let feeTypeName, expectedAmount = null;
  if (feeTypeId) {
    const feeTypeRow = rows.find(r => r.type === 'feeType' && r.recordId === feeTypeId);
    if (!feeTypeRow) return { ok: false, error: 'That fee type is no longer available. Please refresh and try again.' };
    const feeType = safeParse(feeTypeRow.payload);
    feeTypeName = feeType.name;
    expectedAmount = feeType.amount || null;
  } else {
    feeTypeName = customFeeName;
  }

  const studentRow = found.studentRow;

  const paymentReference = 'PAY-' + Utilities.getUuid().slice(0, 8).toUpperCase();
  const nowIso = new Date().toISOString();
  const recordId = 'rec_' + Utilities.getUuid().slice(0, 10);

  appendRow(dataSheet, DATA_COLS, {
    orgId, recordId, ownerUserId: '', type: 'feePayment',
    payload: JSON.stringify({
      studentId: studentRow.recordId,
      admissionNo: found.student.admissionNo, fullName, class: className, arm: arm || '', term, session,
      feeTypeId: feeTypeId || null, feeTypeName, expectedAmount,
      declaredAmount: Number(amountPaid), receiptDataUrl: receiptDataUrl || '',
      payerEmail, paymentReference,
      status: 'pending', confirmedAmount: null, bursarNote: '',
      submittedAt: nowIso, confirmedAt: null, confirmedBy: null
    }),
    createdAt: nowIso, updatedAt: nowIso
  });

  // Alert Bursar/Admin — best effort; a missing/misconfigured MailApp quota shouldn't fail the submission.
  try {
    const usersSheet = getSheet(USERS_SHEET, orgId);
    const userRows = readRows(usersSheet, USER_COLS).filter(r => r.orgId === orgId && r.email);
    const recipients = userRows.filter(r => rolesToArray(r.roles).some(role => FINANCE_ROLES.includes(role)));
    recipients.forEach(r => {
      MailApp.sendEmail({
        to: r.email,
        subject: `${APP_NAME} — New Payment Submitted (${paymentReference})`,
        htmlBody: `
          <p>A new fee payment was submitted and is awaiting your review.</p>
          <ul>
            <li><strong>Student:</strong> ${escapeHtml(fullName)} (${escapeHtml(admissionNo)})</li>
            <li><strong>Class:</strong> ${escapeHtml(className)} ${escapeHtml(arm||'')}</li>
            <li><strong>Fee:</strong> ${escapeHtml(feeTypeName)} — ${term} ${session}</li>
            <li><strong>Amount declared:</strong> ${amountPaid}</li>
            <li><strong>Reference:</strong> ${paymentReference}</li>
          </ul>
          <p>Please log in and review it on the Fee Payments page.</p>`
      });
    });
  } catch (err) { /* email is best-effort; submission still succeeds */ }

  return { ok: true, paymentReference };
}

function handleConfirmFeePayment(body, user) {
  const { recordId, decision, confirmedAmount, bursarNote } = body; // decision: 'confirmed' | 'rejected'
  if (!recordId || !decision) return { ok: false, error: 'Missing fields' };

  const dataSheet = getSheet(DATA_SHEET, user.orgId);
  const rows = readRows(dataSheet, DATA_COLS);
  const idx = rows.findIndex(r => r.recordId === recordId && r.orgId === user.orgId && r.type === 'feePayment');
  if (idx === -1) return { ok: false, error: 'Payment not found' };
  const payment = safeParse(rows[idx].payload);
  if (payment.status !== 'pending') return { ok: false, error: 'This payment has already been processed.' };

  const amount = decision === 'confirmed' ? Math.max(0, Number(confirmedAmount) || 0) : 0;
  const statusLabel = decision === 'rejected' ? 'rejected'
    : (payment.expectedAmount && amount >= payment.expectedAmount) ? 'confirmed-full'
    : amount > 0 ? 'confirmed-partial' : 'confirmed-unpaid';

  const nowIso = new Date().toISOString();
  updateRow(dataSheet, DATA_COLS, idx, {
    payload: JSON.stringify({
      ...payment, status: statusLabel, confirmedAmount: amount,
      bursarNote: bursarNote || '', confirmedAt: nowIso, confirmedBy: user.fullName
    }),
    updatedAt: nowIso
  });

  // Propagate a confirmed amount into the student's feeRecord for that term/session, so
  // Finance & Clearance, the public result checker's clearance check, and everywhere else
  // that reads feeRecord picks it up on next sync/refresh — this is near-real-time (driven
  // by sync.js's polling and focus/online triggers), not a live push.
  if (amount > 0 && payment.studentId) {
    const feeRows = readRows(dataSheet, DATA_COLS);
    const feeIdx = feeRows.findIndex(r => r.orgId === user.orgId && r.type === 'feeRecord' &&
      safeParse(r.payload).studentId === payment.studentId &&
      safeParse(r.payload).term === payment.term && safeParse(r.payload).session === payment.session);
    if (feeIdx !== -1) {
      const fr = safeParse(feeRows[feeIdx].payload);
      updateRow(dataSheet, DATA_COLS, feeIdx, {
        payload: JSON.stringify({ ...fr, amountPaid: Number(fr.amountPaid || 0) + amount }),
        updatedAt: nowIso
      });
    } else {
      const newFeeId = 'rec_' + Utilities.getUuid().slice(0, 10);
      appendRow(dataSheet, DATA_COLS, {
        orgId: user.orgId, recordId: newFeeId, ownerUserId: user.userId, type: 'feeRecord',
        payload: JSON.stringify({
          studentId: payment.studentId, class: payment.class, arm: payment.arm,
          term: payment.term, session: payment.session,
          amountDue: payment.expectedAmount || 0, amountPaid: amount
        }),
        createdAt: nowIso, updatedAt: nowIso
      });
    }
  }

  // Email the payer their status — best effort.
  try {
    if (payment.payerEmail) {
      const subjectLabel = { 'confirmed-full':'Payment Confirmed — Fully Paid', 'confirmed-partial':'Payment Confirmed — Partial', 'confirmed-unpaid':'Payment Reviewed — Not Counted', 'rejected':'Payment Rejected' }[statusLabel] || 'Payment Update';
      const bodyLabel = { 'confirmed-full':'has been confirmed in full', 'confirmed-partial':'has been confirmed as a partial payment', 'confirmed-unpaid':'was reviewed but could not be counted', 'rejected':'was rejected' }[statusLabel] || 'has been reviewed';
      MailApp.sendEmail({
        to: payment.payerEmail,
        subject: `${APP_NAME} — ${subjectLabel} (${payment.paymentReference})`,
        htmlBody: `
          <p>Your payment for <strong>${escapeHtml(payment.fullName)}</strong> (${escapeHtml(payment.admissionNo)}), reference <strong>${payment.paymentReference}</strong>, ${bodyLabel}.</p>
          <p><strong>Fee:</strong> ${escapeHtml(payment.feeTypeName)} — ${payment.term} ${payment.session}<br>
          <strong>Amount confirmed:</strong> ${amount}</p>
          ${bursarNote ? `<p><strong>Note from the school:</strong> ${escapeHtml(bursarNote)}</p>` : ''}
          ${statusLabel === 'rejected' || statusLabel === 'confirmed-unpaid' ? '<p>Please contact the school office if you have questions.</p>' : ''}
        `
      });
    }
  } catch (err) { /* email is best-effort */ }

  return { ok: true, status: statusLabel };
}

// Admin/Bursar sends every parent in a class the current fee list + their child's balance,
// by email. Resolves each parent's contact the same way Parent Communication does: the
// linked Parent record first, falling back to the Student's own guardianEmail.
function handleSendFeeListEmail(body, user) {
  const { classFilter, arm, term, session } = body;
  if (!classFilter) return { ok: false, error: 'Select a class' };

  const dataSheet = getSheet(DATA_SHEET, user.orgId);
  const rows = readRows(dataSheet, DATA_COLS).filter(r => r.orgId === user.orgId);
  const feeTypes = rows.filter(r => r.type === 'feeType').map(r => safeParse(r.payload));
  const totalDue = feeTypes.reduce((s, f) => s + Number(f.amount || 0), 0);
  const feeListHtml = feeTypes.map(f => `<li>${escapeHtml(f.name)} — ₦${Number(f.amount || 0).toLocaleString()}</li>`).join('');

  const students = rows.filter(r => r.type === 'student').map(r => ({ recordId: r.recordId, ...safeParse(r.payload) }))
    .filter(s => s.class === classFilter && (!arm || s.arm === arm));
  const parents = rows.filter(r => r.type === 'parent').map(r => safeParse(r.payload));
  const feeRecords = rows.filter(r => r.type === 'feeRecord').map(r => safeParse(r.payload));

  let sent = 0;
  const skipped = [];

  students.forEach(st => {
    const parentRec = parents.find(p => (p.linkedStudentIds || []).includes(st.recordId));
    const email = (parentRec && parentRec.email) || st.guardianEmail;
    if (!email) { skipped.push({ name: st.fullName, reason: 'No parent/guardian email on file' }); return; }

    const feeRec = feeRecords.find(f => f.studentId === st.recordId && f.term === term && f.session === session);
    const amountPaid = feeRec ? Number(feeRec.amountPaid || 0) : 0;
    const balance = Math.max(0, totalDue - amountPaid);

    try {
      MailApp.sendEmail({
        to: email,
        subject: `${APP_NAME} — Fee List for ${escapeHtml(st.fullName)} (${escapeHtml(classFilter)}${arm ? ' ' + escapeHtml(arm) : ''})`,
        htmlBody: `
          <p>Dear Parent/Guardian of <strong>${escapeHtml(st.fullName)}</strong>,</p>
          <p>Here is the current fee list for <strong>${escapeHtml(classFilter)}${arm ? ' ' + escapeHtml(arm) : ''}</strong>${term ? `, ${escapeHtml(term)} ${escapeHtml(session || '')}` : ''}:</p>
          <ul>${feeListHtml}</ul>
          <p><strong>Total Fees:</strong> ₦${totalDue.toLocaleString()}<br>
          <strong>Amount Paid:</strong> ₦${amountPaid.toLocaleString()}<br>
          <strong>Balance:</strong> ₦${balance.toLocaleString()}</p>
          <p>You can pay online any time via your school's Pay Fees link, or contact the school office.</p>
        `
      });
      sent++;
    } catch (err) {
      skipped.push({ name: st.fullName, reason: 'Email send failed' });
    }
  });

  return { ok: true, sent, skipped, totalStudents: students.length };
}

/* ============================== PLATFORM SUPER ADMIN ============================== */
/* Victor's own dashboard — manages every school org's contact/billing details, sends them
   messages, and configures platform-wide branding/payment settings. All actions here are
   gated by withPlatformSession, which checks orgId===PLATFORM_ORG_ID AND the
   'Platform Super Admin' role — a normal org Super Administrator can never reach these,
   no matter what roles they're given, because that check is on orgId, not just role name. */

// Loops every tenant spreadsheet (via the master TenantRegistry) instead of one shared
// sheet. Also folds in the cell-capacity snapshot that checkAllTenantCapacity() (Tenancy.gs)
// last wrote to the registry — this is the ONLY place that data surfaces; org Admins/Users
// never see it.
function handlePlatformListOrgs(body, admin) {
  const registry = readTenantRegistry();
  const orgs = [];
  registry.forEach(reg => {
    let adminRow = null, userCount = 0;
    try {
      const sheet = getSheet(USERS_SHEET, reg.orgId);
      const rows = readRows(sheet, USER_COLS);
      userCount = rows.length;
      adminRow = rows.find(r => rolesToArray(r.roles).includes('Super Administrator'));
    } catch (err) { /* tenant sheet missing/inaccessible — still show registry-known fields */ }
    // Archiving/attendance-mode status — read straight from that org's own Settings record
    // (see readOrgSettingsDirect in Tenancy.gs), same source the monthly archive job itself
    // consults. Falls back to the same defaults settings-lib.js uses if unreadable.
    let orgSettings = {};
    try { orgSettings = readOrgSettingsDirect(reg.orgId); } catch (err) { /* leave defaults below */ }
    orgs.push({
      orgId: reg.orgId, orgName: reg.orgName || (adminRow && adminRow.orgName) || '(unnamed)',
      adminName: adminRow ? adminRow.fullName : '', email: adminRow ? adminRow.email : '',
      phone: adminRow ? adminRow.phone : '', plan: (adminRow && adminRow.plan) || reg.plan || '',
      billingCycle: (adminRow && adminRow.billingCycle) || reg.billingCycle || '',
      subscriptionStatus: adminRow ? adminRow.subscriptionStatus : '',
      trialEndDate: adminRow ? adminRow.trialEndDate || '' : '',
      subscriptionExpiry: adminRow ? adminRow.subscriptionExpiry || '' : '',
      subscriptionStartDate: adminRow ? adminRow.subscriptionStartDate || '' : '',
      createdAt: reg.createdAt, userCount,
      // Cell-capacity monitoring — Super Admin oversight only (see Tenancy.gs).
      capacity: {
        cellsUsed: Number(reg.cellsUsed || 0), cellsPct: Number(reg.cellsPct || 0),
        estMonthsTo90: reg.estMonthsTo90 === '' ? null : Number(reg.estMonthsTo90),
        status: reg.capacityStatus || 'Healthy', recommendation: reg.capacityRecommendation || '',
        lastCheckedAt: reg.capacityLastChecked || '',
        archivingOn: orgSettings.archivingEnabled !== false,
        attendanceMode: orgSettings.attendanceMode === 'detailed' ? 'Detailed' : 'Summary',
        lastArchiveRunAt: reg.lastArchiveRunAt || '',
        lastArchiveRowsMoved: reg.lastArchiveRowsMoved === '' ? 0 : Number(reg.lastArchiveRowsMoved || 0),
        lastArchiveCellsReclaimed: reg.lastArchiveCellsReclaimed === '' ? 0 : Number(reg.lastArchiveCellsReclaimed || 0)
      }
    });
  });
  orgs.sort((a, b) => new Date(b.createdAt) - new Date(a.createdAt));
  return { ok: true, orgs };
}

function handlePlatformUpdateOrgContact(body, admin) {
  const { orgId, orgName, adminName, email, phone } = body;
  if (!orgId) return { ok: false, error: 'Missing orgId' };
  const sheet = getSheet(USERS_SHEET, orgId);
  const rows = readRows(sheet, USER_COLS);
  const idx = rows.findIndex(r => r.orgId === orgId && rolesToArray(r.roles).includes('Super Administrator'));
  if (idx === -1) return { ok: false, error: 'Org not found' };
  const updates = {};
  if (orgName !== undefined) updates.orgName = orgName;
  if (adminName !== undefined) updates.fullName = adminName;
  if (email !== undefined) updates.email = email;
  if (phone !== undefined) updates.phone = phone;
  updateRow(sheet, USER_COLS, idx, updates);
  return { ok: true };
}

function handlePlatformUpdateOrgPlan(body, admin) {
  const { orgId, plan, billingCycle, subscriptionStatus, trialEndDate, subscriptionExpiry } = body;
  if (!orgId) return { ok: false, error: 'Missing orgId' };
  const sheet = getSheet(USERS_SHEET, orgId);
  const rows = readRows(sheet, USER_COLS);
  const idx = rows.findIndex(r => r.orgId === orgId && rolesToArray(r.roles).includes('Super Administrator'));
  if (idx === -1) return { ok: false, error: 'Org not found' };
  const updates = {};
  if (plan !== undefined) updates.plan = plan;
  if (billingCycle !== undefined) updates.billingCycle = billingCycle;
  if (subscriptionStatus !== undefined) updates.subscriptionStatus = subscriptionStatus;
  if (trialEndDate !== undefined) updates.trialEndDate = trialEndDate;
  if (subscriptionExpiry !== undefined) updates.subscriptionExpiry = subscriptionExpiry;
  if (subscriptionStatus === 'active' && !rows[idx].subscriptionStartDate) {
    updates.subscriptionStartDate = new Date().toISOString();
  }
  updateRow(sheet, USER_COLS, idx, updates);
  return { ok: true };
}

// Sends one org's admin, or every org's admin, a message — email is fully wired via MailApp.
// SMS/WhatsApp are queued into the same platformMessage record for a record-keeping trail,
// but actually dispatching them needs a configured gateway (see Platform Config below) —
// without one, this honestly reports that channel as not sent rather than pretending to.
function handlePlatformSendMessage(body, admin) {
  const { targetOrgId, subject, message, channels } = body; // targetOrgId: orgId or 'ALL'; channels: ['email','sms','whatsapp']
  if (!subject || !message) return { ok: false, error: 'Subject and message are required' };

  const orgIdsToCheck = targetOrgId === 'ALL' ? listTenantOrgIds() : [targetOrgId];
  const targets = [];
  orgIdsToCheck.forEach(orgId => {
    if (orgId === PLATFORM_ORG_ID) return;
    try {
      const rows = readRows(getSheet(USERS_SHEET, orgId), USER_COLS);
      rows.filter(r => rolesToArray(r.roles).includes('Super Administrator')).forEach(r => targets.push(r));
    } catch (err) { /* skip an unreachable tenant rather than failing the whole send */ }
  });
  if (!targets.length) return { ok: false, error: 'No matching organization found' };

  const chans = Array.isArray(channels) && channels.length ? channels : ['email'];
  const config = getPlatformConfigRaw();
  let emailSent = 0;
  const smsSkipped = chans.includes('sms') && !(config.sms && config.sms.enabled);
  const waSkipped = chans.includes('whatsapp') && !(config.whatsapp && config.whatsapp.enabled);

  targets.forEach(t => {
    if (chans.includes('email') && t.email) {
      try {
        MailApp.sendEmail(platformEmailOptions({ to: t.email, subject, htmlBody: `<p>${escapeHtml(message).replace(/\n/g, '<br>')}</p>` }));
        emailSent++;
      } catch (err) { /* best-effort */ }
    }
  });

  const dataSheet = getSheet(DATA_SHEET, PLATFORM_ORG_ID);
  appendRow(dataSheet, DATA_COLS, {
    orgId: PLATFORM_ORG_ID, recordId: 'rec_' + Utilities.getUuid().slice(0, 10), ownerUserId: admin.userId,
    type: 'platformMessage',
    payload: JSON.stringify({ targetOrgId, subject, message, channels: chans, emailSent, sentAt: new Date().toISOString(), sentBy: admin.fullName }),
    createdAt: new Date().toISOString(), updatedAt: new Date().toISOString()
  });

  return {
    ok: true, emailSent, totalTargets: targets.length,
    smsNote: chans.includes('sms') ? (smsSkipped ? 'SMS gateway not configured — not sent. Configure one in Platform Config.' : 'Sent via configured SMS gateway.') : null,
    whatsappNote: chans.includes('whatsapp') ? (waSkipped ? 'WhatsApp gateway not configured — not sent. Configure one in Platform Config.' : 'Sent via configured WhatsApp gateway.') : null
  };
}

// Platform config lives as a single Data record under PLATFORM_ORG_ID, reusing the same
// generic Data tab every school's records live in — no new sheet needed.
function getPlatformConfigRaw() {
  const dataSheet = getSheet(DATA_SHEET, PLATFORM_ORG_ID);
  const row = readRows(dataSheet, DATA_COLS).find(r => r.orgId === PLATFORM_ORG_ID && r.type === 'platformConfig');
  return row ? safeParse(row.payload) : {};
}

function handlePlatformGetConfig(body, admin) {
  return { ok: true, config: getPlatformConfigRaw() };
}

function handlePlatformSaveConfig(body, admin) {
  const { config } = body;
  if (!config || typeof config !== 'object') return { ok: false, error: 'Missing config' };
  const dataSheet = getSheet(DATA_SHEET, admin.orgId);
  const rows = readRows(dataSheet, DATA_COLS);
  const idx = rows.findIndex(r => r.orgId === PLATFORM_ORG_ID && r.type === 'platformConfig');
  const now = new Date().toISOString();
  if (idx === -1) {
    appendRow(dataSheet, DATA_COLS, {
      orgId: PLATFORM_ORG_ID, recordId: 'rec_' + Utilities.getUuid().slice(0, 10), ownerUserId: admin.userId,
      type: 'platformConfig', payload: JSON.stringify(config), createdAt: now, updatedAt: now
    });
  } else {
    updateRow(dataSheet, DATA_COLS, idx, { payload: JSON.stringify(config), updatedAt: now });
  }
  return { ok: true };
}

