function handleSendParentCommunication(body, user) {
  const { recipients, channels, templateType } = body;
  if (!Array.isArray(recipients) || !recipients.length) return { ok: false, error: 'No recipients selected' };
  if (!Array.isArray(channels) || !channels.length) return { ok: false, error: 'Select at least one channel (Email/SMS/WhatsApp)' };

  const dataSheet = getSheet(DATA_SHEET, user.orgId);
  const nowIso = new Date().toISOString();
  const results = [];

  recipients.forEach(r => {
    const perChannel = {};
    if (channels.includes('email')) {
      if (r.email) {
        try {
          MailApp.sendEmail({ to: r.email, subject: r.subject || 'Message from your school', htmlBody: (r.body || '').replace(/\n/g, '<br>') });
          perChannel.email = 'sent';
        } catch (err) { perChannel.email = 'failed'; }
      } else { perChannel.email = 'no email on file'; }
    }
    if (channels.includes('sms')) {
      if (r.phone) {
        const res = sendSmsViaGateway(r.phone, r.body || '');
        perChannel.sms = res.ok ? 'sent' : 'gateway not configured';
      } else { perChannel.sms = 'no phone on file'; }
    }
    if (channels.includes('whatsapp')) {
      if (r.phone) {
        const res = sendWhatsappViaGateway(r.phone, r.body || '');
        perChannel.whatsapp = res.ok ? 'sent' : 'gateway not configured';
      } else { perChannel.whatsapp = 'no phone on file'; }
    }

    const recordId = 'rec_' + Utilities.getUuid().slice(0, 10);
    appendRow(dataSheet, DATA_COLS, {
      orgId: user.orgId, recordId, ownerUserId: user.userId, type: 'parentMessage',
      payload: JSON.stringify({
        recipientName: r.name, recipientEmail: r.email || '', recipientPhone: r.phone || '',
        templateType: templateType || 'personalized', subject: r.subject || '', body: r.body || '',
        channels: perChannel, sentBy: user.fullName, sentAt: nowIso
      }),
      createdAt: nowIso, updatedAt: nowIso
    });
    results.push({ name: r.name, channels: perChannel });
  });

  return { ok: true, results };
}

/* ============================== INTERNAL STAFF MESSAGING ============================== */
/* Deliberately NOT routed through generic saveData/getData — those are role-based (anyone
   with a matching role sees every record of that type), which is wrong for private messages.
   These three actions instead check sender/recipient membership directly, so a message is
   only ever visible to the people it was actually sent between. */

function handleSendStaffMessage(body, user) {
  const { toUserIds, subject, body: msgBody } = body;
  if (!Array.isArray(toUserIds) || !toUserIds.length) return { ok: false, error: 'Select at least one recipient' };
  if (!msgBody || !String(msgBody).trim()) return { ok: false, error: 'Message cannot be empty' };

  // Confirm every recipient is a real user in the same org.
  const usersSheet = getSheet(USERS_SHEET, user.orgId);
  const userRows = readRows(usersSheet, USER_COLS).filter(r => r.orgId === user.orgId);
  const validIds = new Set(userRows.map(r => r.userId));
  const cleanRecipients = toUserIds.filter(id => validIds.has(id) && id !== user.userId);
  if (!cleanRecipients.length) return { ok: false, error: 'No valid recipients' };

  const dataSheet = getSheet(DATA_SHEET, user.orgId);
  const nowIso = new Date().toISOString();
  const recordId = 'rec_' + Utilities.getUuid().slice(0, 10);
  appendRow(dataSheet, DATA_COLS, {
    orgId: user.orgId, recordId, ownerUserId: user.userId, type: 'staffMessage',
    payload: JSON.stringify({
      fromUserId: user.userId, fromName: user.fullName,
      toUserIds: cleanRecipients, subject: subject || '(no subject)', body: msgBody,
      sentAt: nowIso, readBy: []
    }),
    createdAt: nowIso, updatedAt: nowIso
  });
  return { ok: true, recordId };
}

function handleListMyStaffMessages(body, user) {
  const dataSheet = getSheet(DATA_SHEET, user.orgId);
  const rows = readRows(dataSheet, DATA_COLS).filter(r => r.orgId === user.orgId && r.type === 'staffMessage');
  const mine = rows
    .map(r => ({ recordId: r.recordId, payload: safeParse(r.payload) }))
    .filter(r => r.payload.fromUserId === user.userId || (r.payload.toUserIds || []).includes(user.userId));
  mine.sort((a, b) => new Date(b.payload.sentAt) - new Date(a.payload.sentAt));
  return { ok: true, messages: mine };
}

function handleMarkStaffMessageRead(body, user) {
  const { recordId } = body;
  if (!recordId) return { ok: false, error: 'Missing recordId' };
  const dataSheet = getSheet(DATA_SHEET, user.orgId);
  const rows = readRows(dataSheet, DATA_COLS);
  const idx = rows.findIndex(r => r.recordId === recordId && r.orgId === user.orgId && r.type === 'staffMessage');
  if (idx === -1) return { ok: false, error: 'Message not found' };
  const msg = safeParse(rows[idx].payload);
  if (!(msg.toUserIds || []).includes(user.userId)) return { ok: false, error: 'Not a recipient of this message' };
  if (!(msg.readBy || []).includes(user.userId)) {
    msg.readBy = [...(msg.readBy || []), user.userId];
    updateRow(dataSheet, DATA_COLS, idx, { payload: JSON.stringify(msg), updatedAt: new Date().toISOString() });
  }
  return { ok: true };
}

/* ============================== SHEET UTILITIES ============================== */

// orgId is REQUIRED — every sheet now lives inside that org's own tenant spreadsheet.
// See Tenancy.gs for getOrgSpreadsheet(). PLATFORM_ORG_ID resolves to the master spreadsheet.
function getSheet(name, orgId) {
  if (!orgId) throw new Error(`getSheet("${name}") called without an orgId`);
  const ss = getOrgSpreadsheet(orgId);
  const sheet = ss.getSheetByName(name);
  if (!sheet) throw new Error(`Sheet "${name}" not found for org ${orgId}`);
  return sheet;
}

function readRows(sheet, cols) {
  const lastRow = sheet.getLastRow();
  if (lastRow < 2) return [];
  const values = sheet.getRange(2, 1, lastRow - 1, cols.length).getValues();
  return values.map(row => {
    const obj = {};
    cols.forEach((c, i) => obj[c] = row[i] === undefined ? '' : String(row[i]));
    return obj;
  });
}

// Google Sheets rejects any single cell over 50,000 characters, which would otherwise surface as an opaque
// server error half-way through a save. Catch it first and say what to do.
const MAX_CELL_CHARS = 49000;
function assertCellSizes(values) {
  for (let i = 0; i < values.length; i++) {
    if (typeof values[i] === 'string' && values[i].length > MAX_CELL_CHARS) {
      throw new Error('This item is too large to store (usually an image). Please use a smaller or lower-quality image and try again.');
    }
  }
}

function appendRow(sheet, cols, data) {
  const values = cols.map(c => data[c] !== undefined ? data[c] : '');
  assertCellSizes(values);
  sheet.appendRow(values);
}

function updateRow(sheet, cols, idx, updates) {
  const rowNum = idx + 2;
  const range = sheet.getRange(rowNum, 1, 1, cols.length);
  const current = range.getValues()[0];
  cols.forEach((c, i) => { if (updates[c] !== undefined) current[i] = updates[c]; });
  assertCellSizes(current);
  range.setValues([current]);
}

function safeParse(str) {
  try { return JSON.parse(str); } catch (e) { return {}; }
}

function escapeHtml(str) {
  return String(str).replace(/[&<>"']/g, m => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[m]));
}

function jsonOut(obj) {
  return ContentService.createTextOutput(JSON.stringify(obj)).setMimeType(ContentService.MimeType.JSON);
}
