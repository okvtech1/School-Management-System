// Record types that must NEVER be reachable through the generic saveData/getData/deleteData
// actions, no matter the caller's role — including admin-tier, which normally bypasses every
// other per-type check. Messages are scoped by sender/recipient identity (see
// handleSendStaffMessage/handleListMyStaffMessages), not by role, so letting the generic,
// role-based Data endpoints touch them would both let anyone forge a message via saveData
// (fake sender, unvalidated recipients) and let an Admin's own device silently cache every
// other staff member's private messages on any ordinary sync pull.
const GENERIC_DATA_BLOCKED_TYPES = ['staffMessage', 'parentMessage', 'attendance', 'attendanceSummary'];
// attendance/attendanceSummary are blocked from generic sync (same treatment as the message
// types above) because attendanceSummary's counters must only ever move via the diffing
// logic in handleMarkAttendance — a generic overwrite (even from an admin-tier account)
// would silently corrupt "X/Y days present" figures. Reading either type goes through the
// dedicated handleGetAttendanceForClass / handleGetAttendanceSummary actions instead.
const ATTENDANCE_ROLES = ['Super Administrator','School Administrator','Principal / Head Teacher','Academic Officer / Exam Officer','Teacher'];

function canReadType(userRoles, type){
  if (GENERIC_DATA_BLOCKED_TYPES.includes(type)) return false; // no exceptions, not even admin-tier
  const arr = rolesToArray(userRoles);
  if (isAdminTier(userRoles)) return true;
  if (DATA_READ_ROLES[type]) return arr.some(r => DATA_READ_ROLES[type].includes(r));
  return false; // unlisted types fall back to owner-only, handled by caller
}
function canWriteType(userRoles, type){
  if (GENERIC_DATA_BLOCKED_TYPES.includes(type)) return false; // no exceptions, not even admin-tier
  const arr = rolesToArray(userRoles);
  if (isAdminTier(userRoles)) return true;
  if (DATA_WRITE_ROLES[type]) return arr.some(r => DATA_WRITE_ROLES[type].includes(r));
  return false;
}

